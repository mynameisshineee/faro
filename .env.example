# llminbox — copy to `.env` and point it at your ledgers.
# `./llmi init` writes this for you by scanning your disk.

# Which markdown files to index: name=/path/inside/container, comma-separated.
# Paths are as mounted in docker-compose.override.yml, not host paths.
LLMINBOX_LEDGERS=team=/ledgers/team/LEDGER.md,spoke=/ledgers/spoke/AGENT_LEDGER.md

# Auth token. Required — the service starts mute without it and serves nothing.
# `./llmi init` generates one into ~/.llminbox.token (mode 0600).
LLMINBOX_TOKEN=

# How often to check the files for growth, in seconds.
LLMINBOX_POLL=2.0

# Host port. Loopback only; see the security notes in the README.
LLMINBOX_PORT=8077
