# Valida ANTES de stdout el sobre textual completo. Devuelve `NADA` para el sentinel
# exacto o el último arrival de la única sección esperada. No corrige ni recorta un pie
# mentiroso: una contradicción es error de protocolo, nunca material para un ACK.
_valida_respuesta_inbox() {  # $1=ledger esperado · $2=carril esperado (ambos vacíos sólo global) · stdin
  python3 -c 'import base64,json,re,sys,time
expected=sys.argv[1]
expected_lane=sys.argv[2] or None
s=sys.stdin.read()
# El here-string añade UN LF de transporte; `$(...)` ya quitó los del cuerpo HTTP.
if s.endswith("\n"): s=s[:-1]
if re.fullmatch(r"\(nada nuevo para [^()\r\n]+\)",s):
    print("NADA"); raise SystemExit
if re.fullmatch(r"\(nada nuevo para [^()\r\n]+\)\n\n"
                r"\(fuera de la bandeja por archivo: [^\r\n]+ "
                r"— consúltalos con /entries\?ledger=…\)",s):
    print("NADA"); raise SystemExit
marker="\n\nconfirmación disponible — el CLI valida este sobre:\n"
if marker not in s:
    raise SystemExit(1)
visible=s.split(marker,1)[0]
footer=s.split(marker,1)[1]
flines=[x.strip() for x in footer.splitlines() if x.strip()]
if len(flines)!=2 or not re.fullmatch(r"POST /inbox/[^/\s]+/ack",flines[0]):
    raise SystemExit(1)
try: claim=json.loads(flines[1])
except Exception: raise SystemExit(1)
if (not isinstance(claim,dict) or set(claim) not in ({"hasta"},{"hasta","ack"},
                                                     {"hasta","ack_unavailable"})
        or not isinstance(claim["hasta"],dict)):
    raise SystemExit(1)
shown={}; counts={}; ledger=None
section=re.compile(r"^── (.+?) · ([0-9]+) de [0-9]+ para ti(?: |$)")
entry=re.compile(r"^  [^ ]+ #([0-9]+) L[0-9]+(?: |$)")
for line in visible.splitlines():
    m=section.match(line)
    if m:
        ledger=m.group(1)
        if ledger in shown: raise SystemExit(1)
        shown[ledger]=[]; counts[ledger]=int(m.group(2)); continue
    m=entry.match(line)
    if m and ledger is not None:
        shown[ledger].append(int(m.group(1)))
if not shown or (expected and set(shown)!={expected}) or set(claim["hasta"])!=set(shown):
    raise SystemExit(1)
for name,rows in shown.items():
    val=claim["hasta"].get(name)
    if not rows or counts[name]!=len(rows) or isinstance(val,bool) or not isinstance(val,int) or val!=max(rows):
        raise SystemExit(1)
ack=claim.get("ack")
if ack is None:
    unavailable=claim.get("ack_unavailable")
    if unavailable is not None:
        if (not isinstance(unavailable,dict) or set(unavailable)!={"code","retryable"}
                or unavailable.get("code") not in {"ACK_STORE_BUSY","ACK_STORE_UNAVAILABLE","ACK_IDENTITY_REQUIRED",
                                                    "ACK_SCOPE_AMBIGUOUS","ACK_GRANT_RECHAZADO"}
                or not isinstance(unavailable.get("retryable"),bool)
                or unavailable["retryable"] != (unavailable["code"]=="ACK_STORE_BUSY")):
            raise SystemExit(1)
        print("READ_ONLY:"+unavailable["code"]); raise SystemExit
    if expected: raise SystemExit(1)  # servidor anterior: no acredita scope ni ACK
    print("GLOBAL"); raise SystemExit
required={"v","grant","principal","role","lane","ledger","cursor_generation","cursor_before",
          "allowed_arrivals","watermark","expires_at"}
if not isinstance(ack,dict) or set(ack)!=required or ack.get("v")!=1:
    raise SystemExit(1)
only_ledger=next(iter(shown)) if len(shown)==1 else None
arrivals=shown.get(only_ledger,[]) if only_ledger else []
MAXI=9223372036854775807
if (not only_ledger or ack.get("ledger")!=only_ledger or len(ack["ledger"])>256
        or not isinstance(ack.get("lane"),str)
        or not re.fullmatch(r"[A-Za-z0-9._-]{1,128}",ack["lane"])
        or (expected_lane is not None and ack.get("lane")!=expected_lane)
        or not isinstance(ack.get("principal"),str) or not ack["principal"]
        or len(ack["principal"])>512
        or not isinstance(ack.get("role"),str) or not ack["role"] or len(ack["role"])>128
        or not isinstance(ack.get("cursor_generation"),int)
        or isinstance(ack.get("cursor_generation"),bool)
        or not 0<=ack["cursor_generation"]<=MAXI
        or not isinstance(ack.get("cursor_before"),int)
        or isinstance(ack.get("cursor_before"),bool)
        or not -1<=ack["cursor_before"]<=MAXI
        or ack.get("allowed_arrivals")!=arrivals
        or not arrivals or len(arrivals)>200
        or arrivals!=sorted(set(arrivals))
        or any(not isinstance(x,int) or isinstance(x,bool) or not 0<=x<=MAXI
               for x in arrivals)
        or any(x<=ack["cursor_before"] for x in arrivals)
        or ack.get("watermark")!=max(arrivals)
        or not isinstance(ack.get("expires_at"),int)
        or isinstance(ack.get("expires_at"),bool)
        or not 0<ack["expires_at"]<=MAXI or ack["expires_at"]<=int(time.time())
        or not re.fullmatch(r"[A-Za-z0-9_-]{40,128}",str(ack.get("grant","")))):
    raise SystemExit(1)
contract=base64.urlsafe_b64encode(json.dumps(ack,sort_keys=True,separators=(",",":"),
                                               ensure_ascii=False).encode()).decode().rstrip("=")
# La MISMA cota de contrato que aplica `ack` (`ACK_CONTRATO_MAX_CHARS=32768`,
# servicio.py): un envelope que el propio `ack` rechazaría por longitud no se
# imprime — el productor se niega a entregar una confirmación inutilizable.
if len(contract)>32768: raise SystemExit(1)
print("ACK:%s:%s:%s" % (ack["watermark"],ack["lane"],contract))' "$1" "$2"
}

# GET /inbox/$1: 200 → cuerpo por stdout, rc=0. 422 → censo rechaza el nombre:
# mensaje del servicio a stderr, rc=4. Cualquier otro fallo (conexión, timeout,
# 5xx) → sin_servicio, rc=3. `-f` no distingue 422 de "no hay nadie escuchando":
# los dos vuelven no-cero y sin cuerpo. `-w`+`-o` conservan el código real y el
# cuerpo aparte, para poder mirar los dos.
_get_inbox_o_422() {  # $1=agente $2=limit $3=ledger $4=carril
  local cuerpo cod; local -a Hi
  Hi=("${H[@]}"); [ -n "${4:-}" ] && Hi+=(-H "X-Llminbox-Carril: $4")
  cuerpo="$(mktemp)"
  cod="$(curl -s -m 10 "${Hi[@]}" -o "$cuerpo" -w '%{http_code}' "$API/inbox/$1?limit=$2${3:+&only=$3}")" \
    || { rm -f "$cuerpo"; sin_servicio; return 3; }
  case "$cod" in
    200) cat "$cuerpo"; rm -f "$cuerpo"; return 0 ;;
    422) python3 -c 'import json,sys
try: print(json.load(open(sys.argv[1])).get("detail",""), file=sys.stderr)
except Exception: print(open(sys.argv[1]).read(), file=sys.stderr)' "$cuerpo"
         rm -f "$cuerpo"; return 4 ;;
    *)   rm -f "$cuerpo"; sin_servicio; return 3 ;;
  esac
}

sin_servicio() {
  echo "· llminbox no responde en $API — el markdown sigue ahí, nadie está bloqueado." >&2
  echo "  arráncalo:  llmi up" >&2
  echo "  o tira de lo de siempre:  tail -200 <tu-ledger.md>" >&2
  return 3          # 3 = servicio ausente. Distinto de 1 (hallazgo) y 2 (uso).
}

# ── ¿ESTE `up` APAGARÍA V8, O CAMBIARÍA SU COBERTURA? ────────────────────────
# `LLMINBOX_CREDENCIALES` sale del shell (o de `~/.llminbox-env`), y el compose hace
# `${LLMINBOX_CREDENCIALES:+/credenciales/mapa.json}`: sin ella el servicio arranca con
# `v8.configurado=false` — el gate de identidad APAGADO y sin un aviso. La autoridad no
# puede colgar de que el ambiente de quien arranca traiga algo.
hay_contenedor() { docker inspect "$LLMINBOX_NAME" >/dev/null 2>&1; }

# `on` · `off` · `ausente` · `nomedido` · `noarrancado` — y las CINCO son distintas.
# «Falló el inspect» NO es «no hay contenedor»: un daemon que tarda, un socket que se
# reconecta o un rate-limit devuelven error igual, y compose se recupera un segundo
# después y arranca — apagando V8 con el precheck ya dado por bueno. Sólo el mensaje
# explícito de Docker («No such object») acredita la ausencia.
#
# Y «existe» tampoco es «llegó a servir»: ver `noarrancado` más abajo.
_estado_v8() {
  # EL ESTADO VIAJA EN LA MISMA LECTURA que el entorno, detrás de un marcador. No es
  # estética: una segunda llamada a `inspect` sería otra ventana entre lo que se mide y
  # lo que se decide, y en este fichero ésa es ya la quinta de la misma familia. El
  # marcador —y no la POSICIÓN— es lo que delimita, para que un `docker` de mentira que
  # sólo sepa emitir el entorno siga clasificándose por el camino de siempre en vez de
  # que sus dos primeras variables pasen por `Status` y `StartedAt`.
  _err="$(mktemp)"; _out="$(docker inspect "$LLMINBOX_NAME" \
      --format '{{range .Config.Env}}{{println .}}{{end}}{{println "@@ESTADO@@"}}{{println .State.Status}}{{println .State.StartedAt}}' 2>"$_err")"; _rc=$?
  # `$(<f)` y NO `cat`: este camino decide si se apaga un gate, y no puede depender de
  # que un binario externo del PATH sea el que crees. Un test del propio repo interpone
  # un `cat` falso para reproducir otra ventana, y con `cat` aquí mi medida pasaba por
  # el doble de otro. Menos superficie, y además no bifurca un proceso.
  _e="$(<"$_err")"; rm -f "$_err"
  if [ "$_rc" -ne 0 ]; then
    case "$_e" in
      *"No such object"*|*"no such object"*|*"No such container"*) echo ausente ;;
      *) echo nomedido ;;
    esac
    return
  fi
  # UN CONTENEDOR QUE NUNCA ARRANCÓ NO ES V8 ENCENDIDO, y tratarlo como tal no era celo:
  # `Config.Env` queda horneado en cuanto Docker CREA el contenedor, así que un `up` que
  # murió al hacer `bind` del puerto deja un husk en `created` que puntuaba `on`. Y ese
  # `on` BLOQUEA el reintento pidiendo `--cobertura-verificada`, un flag cuyo significado
  # es «ya comparé el mapa nuevo con el vivo» — imposible cuando no hay ninguno vivo.
  # Medido: los dos remedios que el propio mensaje imprime tampoco corren contra un
  # contenedor parado (`llmi credenciales` → rc=3 «is not running»; `curl $API/health` →
  # rc=28, nada escuchando), así que la única salida era firmar en vacío. Un flag que se
  # aprende a pasar sin contenido deja de proteger cuando SÍ hay cobertura que perder:
  # el daño no es la fricción, es la erosión del flag.
  #
  # SE EXIGEN LAS DOS SEÑALES: `created` Y `StartedAt` en el cero de Go. Un contenedor
  # PARADO que sí llegó a correr trae `exited` y una fecha real, y sigue evaluándose como
  # antes — ése SÍ pudo servir identidad, y su gate se conserva entero.
  case "$_out" in
    *"@@ESTADO@@"*)
      _cola="${_out#*@@ESTADO@@}"
      _st="$(printf %s "$_cola" | sed -n 2p)"
      _desde="$(printf %s "$_cola" | sed -n 3p)"
      case "$_st" in
        created) case "$_desde" in 0001-01-01T*) echo noarrancado; return ;; esac ;;
      esac ;;
  esac
  # SIN MARCADOR NO SE INVENTA NADA: se cae al camino de siempre, que es el conservador.
  _env="${_out%%@@ESTADO@@*}"
  [ -n "$_env" ] || { echo nomedido; return; }   # existe y sin `Config.Env`: imposible
  printf %s "$_env" | grep -q '^LLMINBOX_CREDENCIALES=..*' && { echo on; return; }
  echo off
}

# LA HUELLA DEL MAPA APLICADO. `Config.Env` dice la RUTA INTERNA del mapa montado
# (`/credenciales/mapa.json`), que es la misma para cualquier fichero: **desde el
# contenedor no se puede saber a QUÉ mapa corresponde ni a cuántos roles cubre**. Así
# que un mapa nuevo «no vacío» pasaba el gate y podía REDUCIR o SUSTITUIR la cobertura
# sin que nada lo midiera. Se guarda la huella (sha256, nunca el contenido) del mapa
# que se aplicó, y un mapa DISTINTO exige que alguien haya medido la cobertura.
_huella_mapa() {
  [ -r "${1:-}" ] || return 1
  python3 -c 'import hashlib,sys;print(hashlib.sha256(open(sys.argv[1],"rb").read()).hexdigest())' "$1" 2>/dev/null
}
_fichero_huella() { echo "${LLMI_LOCK_DIR:-$HOME}/.llmi-v8-mapa-$LLMINBOX_NAME.sha256"; }
_fichero_snapshot() { echo "${LLMI_LOCK_DIR:-$HOME}/.llmi-v8-mapa-$LLMINBOX_NAME.json"; }


# ── CERROJO DE CICLO DE VIDA ──────────────────────────────────────────────────
# `build` y `up` son operaciones DISTINTAS del MISMO ciclo de vida mutable, así que
# comparten cerrojo: un `build` que cambia la imagen mientras un `up` decide qué
# hacer con ella es la misma carrera con otro disfraz.
#
# Se toma ANTES del primer efecto lateral, no antes de la parte que parecía
# peligrosa. Con el token/roster/mounts creados fuera del cerrojo, dos `up` en un
# checkout limpio todavía podían pisarse: los dos ven que no hay token, los dos lo
# generan, uno arranca Docker con el suyo y el disco acaba con el del otro —
# servicio vivo con credenciales que ya no coinciden con las del cliente.
#
# «No conseguí exclusión» tiene que significar «no toqué nada».
#
# `mkdir` es atómico en POSIX y no necesita `flock`, que no está en macOS. Se
# RECHAZA en vez de esperar: dos despliegues a la vez no son una cola, son un
# accidente. Sin TTL: el `trap` libera los fallos controlados, y un cerrojo huérfano
# (SIGKILL, caída de la máquina) se limpia a mano — un vencimiento automático
# volvería a ser una heurística.
_tomar_cerrojo() {
  # POR INSTANCIA, NO POR CHECKOUT. Vivía en `$DIR`, así que dos checkouts del MISMO
  # proyecto —este repo y el worktree de despliegue— tomaban cerrojos DISTINTOS y
  # entraban los dos a la vez en el ciclo de vida del mismo contenedor. El cerrojo
  # tiene que nombrar lo que protege, y lo que se protege es la instancia.
  _LOCK="${LLMI_LOCK_DIR:-$HOME}/.llmi-lifecycle-$LLMINBOX_NAME.lock"
  mkdir "$_LOCK" 2>/dev/null || {
    echo "· hay otro \`llmi up\` o \`llmi build\` en marcha" >&2
    echo "  (o quedó un cerrojo de uno que murió sin poder limpiarlo)" >&2
    echo "  si estás seguro de que no corre ninguno: rmdir $_LOCK" >&2
    exit 1; }
  # Encadena en vez de pisar: si sustituyera el trap, el fichero de credencial se
  # quedaría en /tmp con el secreto dentro. Y ENUMERAR a mano las otras limpiezas aquí
  # tampoco vale — es la misma trampa un piso más abajo: quien añada una cuarta tendría
  # que acordarse de este sitio. Se añade SÓLO lo propio.
  # shellcheck disable=SC2016
  # Comillas SIMPLES a propósito: `$_LOCK` tiene que expandirse AL SALIR, no ahora. Si se
  # expandiera aquí, el trap llevaría la ruta congelada del cerrojo de ESTA llamada.
  _encadena_trap_salida 'rmdir "$_LOCK" 2>/dev/null'
}


