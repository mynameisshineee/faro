import json, sys

MODOS = ("bridge", "native", "native-required")
DUREZA = {m: i for i, m in enumerate(MODOS)}
NO_DECL = None

formato, carril, verbo = sys.argv[1], sys.argv[2], sys.argv[3]
resto = sys.argv[4:]
fuentes = [{"ruta": resto[i], "origen": resto[i + 1]} for i in range(0, len(resto), 2)]

errores = []

def leer(ruta):
    """(declaraciones, error). declaraciones = {(lane,verb): modo}. Ausente != vacio."""
    try:
        with open(ruta, encoding="utf-8") as fh:
            d = json.load(fh)
    except FileNotFoundError:
        return None, None                      # ausente: el resolutor lo salta
    except Exception as e:
        return None, "no se puede leer o no es JSON: %s" % e
    if not isinstance(d, dict):
        return None, "la raiz no es un objeto"
    lanes = d.get("lanes")
    if not isinstance(lanes, dict):
        return None, "falta `lanes` o no es un objeto"
    decl = {}
    for ln, verbos in lanes.items():
        if not isinstance(verbos, dict):
            return None, "lanes[%r] no es un objeto" % ln
        for vb, modo in verbos.items():
            if modo not in MODOS:
                return None, "modo desconocido %r en (%s,%s)" % (modo, ln, vb)
            decl[(ln, vb)] = modo
    return decl, None

for f in fuentes:
    decl, err = leer(f["ruta"])
    if err:
        f["estado"] = "ILEGIBLE"; f["error"] = err
        errores.append((f["ruta"], err))
    elif decl is None:
        f["estado"] = "ausente"
        # El resolutor salta lo que no puede leer. Si la RUTA la senalo el operador a
        # proposito por variable de entorno, que no este es una configuracion rota que
        # nadie ve: se marca, y no se convierte en un error para no mentir sobre lo que
