            || { [ $# -eq 3 ] && [ "$1" = "migrate" ] \
                 && [ "$2" = "1" ] && [ "$3" = "2" ]; } \
            || { mal_uso; }
          docker inspect "$LLMINBOX_NAME" >/dev/null 2>&1 \
            || { sin_servicio; exit 3; }
          docker exec "$LLMINBOX_NAME" python3 -m servicio search "$@" ;;
  credenciales)
          # COMPROBAR EL MAPA DE V8 ANTES DE DESPLEGARLO. Existe porque el arranque
          # fail-closed que YO puse lo hizo necesario: un mapa presente e invalido NO
          # ARRANCA el servicio y deja sin bus a las ~71 sesiones de la flota.
          #
          # ⚠️ CORRE EN EL CONTENEDOR VIVO (`docker exec`), NO en uno nuevo. Tercera
          # version de este comando y el tercer falso rojo, todos por el ENTORNO:
          #   ① `python3` del host  → sin fastapi ⇒ ⛔ a todos los mapas
          #   ② imagen anterior a V8 → AttributeError ⇒ el mismo ⛔
          #   ③ `docker compose run` desde la cara de host de la FLOTA → esa copia no
          #      tiene `docker-compose.override.yml` (es de la maquina, no va en git),
          #      asi que el contenedor nuevo nace SIN `/state` ⇒ sin censo ⇒ NINGUN rol
          #      resuelve ⇒ ⛔ a un mapa perfectamente valido. Lo midio @infra.
          #
          # El contenedor VIVO ya tiene el censo, los carriles y los montajes REALES.
          # Validar contra el es validar contra lo que va a arrancar, no contra una
          # reconstruccion que puede diferir — que es justo lo que fallaba.
