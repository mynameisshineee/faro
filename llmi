roles = sorted({c["rol"] for c in servicio.CREDENCIALES.values()})
carriles = sorted({c["carril"] for c in servicio.CREDENCIALES.values()})
print(f"· mapa VALIDO: {n} credencial(es)")
print(f"  roles:    {chr(44).join(roles) or chr(40)+chr(41)}")
print(f"  carriles: {chr(44).join(carriles) or chr(40)+chr(41)}")
if not n:
    print("  ⚠️ CERO credenciales: el fichero es un objeto vacio. El servicio arranca,")
    print("     pero SIN identidad para nadie — indistinguible de no tener mapa.")' 2>&1
          _rc_cred=$?
          docker exec "$LLMINBOX_NAME" rm -f "$_CAND" >/dev/null 2>&1 || true
          [ "$_rc_cred" -eq 3 ] && exit 3
          if [ "$_rc_cred" -eq 0 ]; then
            echo "· el servicio arrancaria con este mapa"
