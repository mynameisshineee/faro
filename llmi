#!/usr/bin/env bash
# llmi — la cara de host de `llminbox`. Lo que un agente invoca de verdad.
#
# POR QUÉ EXISTE
#   El primitivo que la flota usa hoy es `tail -N` sobre un fichero de 54 MB:
#   27.983 tokens para ver 49 entradas ≈ 10 minutos de historia a hora punta, y
#   sin forma de preguntar "¿qué hay para MÍ desde la última vez?". Medido
#   2026-07-27: en 5.580 de 6.432 relecturas consecutivas habían aparecido
#   entradas fuera de esa ventana.
#
# PROPIEDAD DE DISEÑO (probada, no prometida — falsador T5)
#   Si el servicio no está, esto NO bloquea a nadie: avisa y te dice el comando
#   de siempre. El markdown sigue siendo el canon; esto es un atajo, no una
#   dependencia. Cualquier cosa que haga que un agente se quede esperando a un
#   contenedor es un bug de este fichero, no un inconveniente.
set -uo pipefail

# `API` NO se fija aquí: `~/.llminbox-env` puede declarar otra instancia y esta línea
# corría ANTES de leerlo. Se resuelve más abajo, junto al nombre de instancia.

# EL DIRECTORIO ES EL DEL REPO, NO EL DEL SYMLINK. `dirname $BASH_SOURCE` a secas
# devuelve dónde está el ENLACE, así que en cuanto alguien pone `llmi` en su PATH con
# un symlink —que es justo lo que hay que hacer para que el manual valga— el script
# busca `publicar.py`, `roster.json` y `.llmi-mounts.json` en `~/.local/bin` y no los
# encuentra: `llmi post` muere con «can't open publicar.py» y `stat` anuncia una
# deriva de montaje FALSA. Medido en el momento de crear el enlace (2026-08-12).
# `readlink -f` no vale: es GNU, y en macOS no existe. Este bucle es el idiom
# portable — sigue la cadena de enlaces hasta el fichero real.
_SRC="${BASH_SOURCE[0]}"
while [ -L "$_SRC" ]; do
  _D="$(cd -P "$(dirname "$_SRC")" && pwd)"
  _SRC="$(readlink "$_SRC")"
  case "$_SRC" in /*) ;; *) _SRC="$_D/$_SRC" ;; esac
done
DIR="$(cd -P "$(dirname "$_SRC")" && pwd)"

# ── LA IDENTIDAD DE LA INSTANCIA, ANTES QUE NADA ─────────────────────────────
# Gobierna TRES cosas —el nombre del contenedor, el proyecto de compose y el cerrojo
# del ciclo de vida— así que se resuelve antes de derivar cualquiera de ellas. Mi
# primera versión calculaba el proyecto ANTES de leer la configuración del operador,
# y con eso su segunda instancia declarada quedaba fuera del pin.
#
# `~/.llminbox-env` es esa configuración canónica, y la lee UN SOLO parser: el que ya
# existía más abajo, MOVIDO aquí arriba. Yo había escrito un SEGUNDO, sin mirar si el
# repo ya tenía uno — y tenerlos dos era la mitad del problema: endurecí el mío y el
# viejo seguía con el agujero.
# EL QUE YA ESTÁ EXPORTADO MANDA: así una prueba puntual (`VAR=x ./llmi up`) sigue pesando
# más que el fichero, que es lo que uno espera de una variable de entorno.
ENVFILE="$HOME/.llminbox-env"
if [ -r "$ENVFILE" ]; then
  while IFS= read -r _linea || [ -n "$_linea" ]; do
    case "$_linea" in ''|'#'*) continue ;; esac
    _k="${_linea%%=*}"; _v="${_linea#*=}"
    # LA CLAVE SE VALIDA ENTERA, NO POR PREFIJO. Sólo se miraba que empezara por
    # `LLMINBOX_`, y la clave acaba DENTRO de un `eval`: una línea como
    #     LLMINBOX_A$(comando)=1
    # pasa el filtro de prefijo y el comando se EJECUTA. MEDIDO antes de curar: se
    # ejecuta. (El VALOR no: la expansión de parámetro no se vuelve a escanear, así que
    # `$(...)` en el valor NO corre — comprobado también, para no curar lo que no falla.)
    case "$_k" in
      LLMINBOX_[A-Z0-9_]*)
        case "$_k" in
          *[!A-Z0-9_]*) echo "· ⛔ $ENVFILE: '$_k' no es un nombre de variable" >&2
                        echo "     sólo [A-Z0-9_] tras LLMINBOX_. Una clave llega a un \`eval\`." >&2
                        exit 1 ;;
        esac ;;
      *) echo "· ⛔ $ENVFILE: '$_k' no empieza por LLMINBOX_." >&2
         echo "     Este fichero configura ESTE servicio; una variable ajena aquí no la lee" >&2
         echo "     nadie y se queda puesta creyendo que aplica." >&2
         exit 1 ;;
    esac
    # Sin llaves alrededor de $_k el shell no sabe dónde acaba el nombre. Y el `eval` va
    # con el valor entrecomillado: un valor con espacios se partiría en dos.
    # SIN `eval`. Validar la clave bloqueaba la inyección que medí, pero dejaba la
    # CLASE viva: cualquier futuro retoque de ese filtro la reabre. El shebang es
    # `bash`, así que hay expansión indirecta (`${!_k-}`) y `printf -v`, las dos en
    # bash 3.2 —el de macOS—, comprobado. Sin `eval` no hay nada que inyectar: ni por
    # la clave ni por el valor.
    if [ -z "${!_k-}" ]; then
      printf -v "$_k" %s "$_v"
      export "${_k?}"   # ${_k?} y no $_k: misma conducta, y calla SC2163
    fi
  done < "$ENVFILE"
fi



# EL NOMBRE SE VALIDA AQUÍ, NO EN DOCKER. Delegar el fallo al último paso significa
# que el error sale del orquestador, con su vocabulario, después de haber intentado
# actuar — y un identificador que no cumple la forma no debería llegar a tocar nada.
LLMINBOX_NAME="${LLMINBOX_NAME:-llminbox}"
case "$LLMINBOX_NAME" in
  # ENUMERADO, NO POR RANGO. `[a-z]` dentro de un `case` depende de la COLACIÓN del
  # locale y en el de esta máquina casa MAYÚSCULAS: `Mayuscula` pasaba el filtro
  # entero. Medido, no supuesto. Un rango en un validador de seguridad es una
  # suposición sobre el entorno de quien lo corre.
  *[!abcdefghijklmnopqrstuvwxyz0123456789_-]*|[!abcdefghijklmnopqrstuvwxyz0123456789]*)
    echo "⛔ nombre de instancia inválido: \`$LLMINBOX_NAME\`" >&2
    echo "   Compose exige [a-z0-9_-] empezando por letra o número MINÚSCULA: si aquí" >&2
    echo "   admito mayúsculas o puntos, el fallo sale luego y con su vocabulario." >&2
    echo "   No llamo a Docker." >&2
    exit 2 ;;
esac
export LLMINBOX_NAME

# EL PROYECTO DE COMPOSE NO SALE DEL DIRECTORIO **NI DEL AMBIENTE**. `container_name`
# es fijo, pero Docker derivaba el PROYECTO de la carpeta desde la que corres, y hay
# dos: este repo y el worktree de despliegue del que cuelga `~/.local/bin/llmi`.
# MEDIDO el 2026-09-04 por @cto: 3 ciclos completos de destroy→create en 108 s
# alternando `llminbox-llminbox` y `1bb10f55e868-llminbox`.
#
# Y NO se respeta un `COMPOSE_PROJECT_NAME` heredado: un override ambiental vuelve a
# abrir DOS proyectos para UN solo nombre de contenedor, que es exactamente el defecto.
# El proyecto ES la instancia; si quieres otra, declárala con `LLMINBOX_NAME`.
if [ -n "${COMPOSE_PROJECT_NAME:-}" ] && [ "$COMPOSE_PROJECT_NAME" != "$LLMINBOX_NAME" ]; then
  echo "· ignoro COMPOSE_PROJECT_NAME=\`$COMPOSE_PROJECT_NAME\` del ambiente:" >&2
  echo "  el proyecto ES la instancia (\`$LLMINBOX_NAME\`). Para otra, usa LLMINBOX_NAME." >&2
fi
export COMPOSE_PROJECT_NAME="$LLMINBOX_NAME"

# Y LA API, AQUÍ, con el envfile ya leído. Estaba ARRIBA DEL TODO, antes de leer
# `~/.llminbox-env` (el bloque de `LLMINBOX_ENVFILE`), así que
# una segunda instancia declarada ahí quedaba fuera: el atestado se le
# pedía a `127.0.0.1:8077`, que es OTRO servicio, y el despliegue se sellaba o se
# bloqueaba por lo que dijera un proceso que no es el suyo. Misma clase que ya curé para
# `COMPOSE_PROJECT_NAME` — y la dejé aquí.
API="${LLMINBOX_API:-http://127.0.0.1:${LLMINBOX_PORT:-8077}}"

# ── EL PREFIJO DE LA SUPERFICIE NATIVA (D9 de @cto-llminbox, 2026-09-05T23:02:17Z) ──
# ⛔ NO CABE EN `$API`, y no es estilo: `$API` es la base de `/health` y de las 28 rutas
# LEGADO. Meterlo ahí movería la bandeja entera al prefijo y rompería el camino que hoy
# funciona — que es exactamente el lado que NO hay que tocar.
#
# Y es `/native/` y no `/v1/` (que fue mi lectura y la primera del CTO): dice de qué
# SUPERFICIE es la ruta, no sólo de qué versión, y eso es lo que hay que poder leer en un
# log donde conviven 28 rutas legado. El ADR no decide esto — `grep 'prefix|/v1'` sobre él
# da 1 hit y es `durable_v`, versión de esquema de BD.
NAT="${LLMINBOX_NATIVE_PREFIX:-/native/v1}"

# ── CREDENCIAL DE WORKLOAD — TRES SECRETOS DISTINTOS, TRES FICHEROS ─────────
# `X-Llminbox-Token` es COMPARTIDO por los 15 agentes y sirve para leer el legado.
# La credencial de despliegue (ésta) identifica a UN workload y su ÚNICA capacidad es
# ABRIR sesión — `POST /sessions` y nada más. ROTAR no: `refresh_session(token)` rota UNA
# sesión concreta, así que va con el token de esa sesión (D8 canónico). El token de sesión
# sale de ahí y es el que muta.
# Mezclarlos es lo que el camino nativo existe para deshacer: si el secreto que abre
# sesión fuera el compartido, los 15 abrirían la sesión del mismo principal y toda la
# atribución del diario sería la misma. Por eso NO hay defecto ni caída al compartido.
#
# En FICHERO, no en variable ni en argumento: un argumento lo ve cualquiera con `ps`, y
# una variable exportada la hereda todo hijo. Mismo patrón que ya usan el token de la
# casa y el del watcher, con su misma comprobación de «existe pero vacío».
WLFILE="${LLMINBOX_WORKLOAD_FILE:-$HOME/.llminbox-workload.credential}"
WLCRED=""; WLFORMA="ok"
if [ -r "$WLFILE" ]; then
  # 🩸 `tr -d '\n'` BORRABA TODOS LOS SALTOS DE LÍNEA ANTES DE VALIDAR NADA: un fichero con
  # `abc<LF>DEF` se cargaba como `abcDEF` —dos cosas pegadas en una credencial que nadie
  # escribió— y encima podía pasar el validador de charset, porque el LF ya no estaba.
  # El validador de contenido no puede correr DESPUÉS de una transformación que borra justo
  # el carácter peligroso.
  #
  # Ahora se valida la FORMA DEL FICHERO primero: una sola línea, con o sin su LF final.
  # `$( )` ya se come los saltos finales, así que el caso legítimo —una credencial y su
  # terminador— funciona sin tocar nada; lo que se rechaza es el LF INTERNO y las líneas
  # de más, sin concatenarlas.
  _wl_lineas="$(awk 'END{print NR}' < "$WLFILE")"
  case "$(tr -dc '\r' < "$WLFILE" | wc -c | tr -d ' ')" in
    0) ;;
    *) WLFORMA="cr" ;;
  esac
  if [ "$WLFORMA" = "ok" ] && [ "${_wl_lineas:-0}" -gt 1 ]; then WLFORMA="multilinea"; fi
  if [ "$WLFORMA" = "ok" ]; then WLCRED="$(cat "$WLFILE")"; fi
fi
if [ "$WLFORMA" != "ok" ]; then
  echo "· CREDENCIAL_MAL_FORMADA · $WLFILE no es UNA sola línea (detectado: $WLFORMA)." >&2
  echo "    ⛔ NO pego las líneas: concatenar produciría una credencial que nadie escribió," >&2
  echo "       y el carácter que sobra es justo el que rompería el fichero de configuración." >&2
  echo "    admitido: una línea, con o sin salto final. Nada de CR ni de líneas de más." >&2
  exit 1
fi
if [ -e "$WLFILE" ] && [ -z "$WLCRED" ]; then
  echo "· ⚠️  \`$WLFILE\` existe pero está VACÍO." >&2
  echo "  Un fichero vacío no es lo mismo que no tenerlo: con esto \`llmi login\` fallaría" >&2
  echo "  con un 401 que parecería del servidor. Suele pasar por un \`echo \"\$VAR\" >\` con la" >&2
  echo "  variable sin definir (cada comando corre en su propia shell)." >&2
  echo "  · bórralo, o escríbelo en UNA sola orden con la credencial que te dio el operador." >&2
  exit 1
fi

# El token NO es opcional. Publicar en 127.0.0.1 no aísla en Docker Desktop para
# macOS: comprobado en vivo, un contenedor de otra red llega por
# `host.docker.internal` y leía el canon entero sin credencial.
TOKFILE="$HOME/.llminbox.token"
if [ -r "$TOKFILE" ]; then TOKEN="$(tr -d '\n' < "$TOKFILE")"; else TOKEN=""; fi

# El token del WATCHER, hermano del de arriba y con su propio fichero a propósito: son dos
# credenciales distintas para dos ámbitos distintos —la de la casa abre las bandejas, ésta
# acredita ciclos y consulta el agregado—, y mezclarlas devolvería a UNA llave para todo.
# Vacío si no existe: el servicio arranca igual y `/health` canta que la vigilancia está
# `inarmable`, que es mejor que morir al arrancar.
# DÓNDE ESTÁ EL CONTRATO DE LA FLOTA. `LLMINBOX_POLICY_DIR` manda; si no, este fichero;
# si tampoco, el `_shared_refs/` VACÍO del repo y el censo dice `ausente`, que es correcto.
#
# El fichero existe porque la variable exportada NO sobrevive: cada `llmi up` es una shell
# nueva, así que un `export` de hace dos comandos no está. Sin esto, `campos_origen` volvía
# de `politica` a `ausente` en el siguiente arranque, en silencio y sin que nadie tocara
# una línea de código — y el gate de alineación de la flota se caía solo. Es el mismo modo
# de fallo que ya me mordió con el token del watcher, un mes después y en otro sitio.
# ── UN SOLO SITIO PARA LO QUE EL OPERADOR CONFIGURA ──────────────────────────────
# `~/.llminbox-env`, líneas `LLMINBOX_X=valor`. Existe porque una variable exportada NO
# sobrevive: cada `llmi up` es una shell nueva. Ya me mordió tres veces —el token del
# watcher, la ruta del contrato, y `LLMINBOX_WIP_GLOBAL`, que le dije a un par que estaba
# «construido, sólo hay que encenderlo» cuando ni siquiera llegaba al contenedor—.
#
# Y ES UN FICHERO, NO UNO POR PERILLA. El primer arreglo fue `~/.llminbox-policy-dir`; con
# el cap por owner habría hecho falta otro, y luego otro. Un dotfile por variable no es
# consolidar, es aplazar. Aquí se declara lo que se quiera y `llmi` lo exporta.
#
# COMPATIBILIDAD: el fichero de una sola perilla que existió antes. Se sigue leyendo porque
# hay un servicio vivo apoyado en él ahora mismo, y se dice dónde va lo nuevo — no se borra
# por debajo a nadie.
PDIRFILE="$HOME/.llminbox-policy-dir"
if [ -z "${LLMINBOX_POLICY_DIR:-}" ] && [ -r "$PDIRFILE" ]; then
  LLMINBOX_POLICY_DIR="$(tr -d '\n' < "$PDIRFILE")"
fi
if [ -n "${LLMINBOX_POLICY_DIR:-}" ] && [ ! -d "$LLMINBOX_POLICY_DIR" ]; then
  # Configurado y apuntando a la nada NO es lo mismo que sin configurar: lo primero es un
  # accidente con forma de decisión. Se para, porque seguir montaría el directorio vacío
  # del repo y el censo diría `ausente` como si nadie hubiera pedido nada.
  echo "· ⛔ LLMINBOX_POLICY_DIR=$LLMINBOX_POLICY_DIR no es un directorio." >&2
  echo "     Apunta al \`_shared_refs\` que contiene fleet-operating-policy.json," >&2
  echo "     o borra $PDIRFILE para arrancar sin contrato (el censo dirá \`ausente\`)." >&2
  exit 1
fi
export LLMINBOX_POLICY_DIR

WTOKFILE="$HOME/.llminbox-watcher.token"
if [ -r "$WTOKFILE" ]; then WATCHER_TOKEN="$(tr -d '\n' < "$WTOKFILE")"; else WATCHER_TOKEN=""; fi

# UN FICHERO VACÍO NO ES UN FICHERO AUSENTE, y confundirlos degrada la vigilancia de la
# flota en silencio. Ausente = «esto no está configurado», legítimo: el servicio arranca y
# `/health` canta `inarmable`. Presente y VACÍO = alguien intentó escribirlo y falló, y eso
# no es una configuración: es un accidente con la misma forma que una decisión.
#
# Pasó de verdad el 2026-08-31, dos veces seguidas y por la misma causa: cada línea `!` del
# operador abre una shell NUEVA, así que un `export VAR=…` en un comando no existe en el
# siguiente y `echo "$VAR" > fichero` escribe una línea en blanco. La primera vez el
# despliegue aún no había ocurrido; la segunda, el token vivo sólo existía ya dentro del
# contenedor y un `llmi up` lo habría borrado para siempre sin avisar.
if [ -e "$WTOKFILE" ] && [ -z "$WATCHER_TOKEN" ]; then
  echo "· ⚠️  \`$WTOKFILE\` existe pero está VACÍO." >&2
  echo "  Un fichero vacío no es lo mismo que no tenerlo: con esto la vigilancia queda" >&2
  echo "  INARMABLE y nadie podrá acreditar ciclos. Suele pasar por un \`echo \\\"\$VAR\\\" >\`" >&2
  echo "  con la variable sin definir (cada comando corre en su propia shell)." >&2
  echo "  · para generarlo de verdad, en UNA sola orden:" >&2
  echo "      python3 -c 'import secrets;print(secrets.token_urlsafe(32))' > $WTOKFILE" >&2
  echo "  · o bórralo si de verdad quieres arrancar sin vigilancia:  rm $WTOKFILE" >&2
  exit 1
fi
# ── EL TOKEN LEGADO TAMPOCO PUEDE IR EN `argv` ─────────────────────────────
# `-H "X-Llminbox-Token: <secreto>"` lo mete en la línea de comandos de `curl`, y el `argv`
# lo lee CUALQUIER proceso del sistema con `ps`. El camino nativo ya sacó su Bearer a un
# fichero de configuración 600 y este quedó dentro: mismo secreto, misma exposición, y es
# el que comparten los 15 agentes — el más caro de filtrar, no el más barato.
# La RUTA del fichero sí es pública; su contenido no.
#
# Se define AQUÍ, y no junto a `_cfg_auth`, porque esto corre en el ARRANQUE: una función
# declarada 1.000 líneas más abajo todavía no existe cuando esta línea se ejecuta.
# ── ENCADENAR EL TRAP DE SALIDA, NUNCA PISARLO ──────────────────────────────
# Aquí hay TRES limpiezas de salida (el config del token legado, el del camino nativo y el
# cerrojo del ciclo de vida) y cada una nació escribiendo `trap ... EXIT` a pelo. El último
# que escribe gana y los anteriores DESAPARECEN sin ruido: un secreto que se queda en /tmp,
# o un cerrojo huérfano que bloquea al siguiente y que ese trap existía para impedir.
# Se define ANTES del primer `trap` del arranque, y por eso NO usa `local`: fuera de una
# función `local` es un error, y este helper se llama también desde el nivel superior.
_encadena_trap_salida() {   # $1 = comando a AÑADIR al trap EXIT
  _etp_previo="$(trap -p EXIT | sed "s/^trap -- '//; s/' EXIT\$//")"
  # shellcheck disable=SC2064
  # La expansión INMEDIATA es deliberada: `$_etp_previo` se captura AHORA, al encadenar.
  # Con comillas simples se evaluaría al SALIR, cuando ya no existe, y el trap anterior se
  # perdería — que es exactamente lo que este encadenado evita.
  if [ -n "$_etp_previo" ]; then trap "$1; $_etp_previo" EXIT; else trap "$1" EXIT; fi
}

_CFGLEG=""
_limpia_cfgleg() { [ -n "${_CFGLEG:-}" ] && rm -f "$_CFGLEG" 2>/dev/null; _CFGLEG=""; return 0; }
_encadena_trap_salida '_limpia_cfgleg'
_cfg_legado() {
  # CHARSET ANTES DE CREAR NADA. Un token con `"` cierra la cadena del fichero de config y
  # con CR/LF abre una SEGUNDA directiva de curl (`output = …` incluida). Se rechaza en vez
  # de escapar: negarse es más seguro que escapar bien, y el fichero lo escribe una persona.
  # ⚠️ El VACÍO no se rechaza aquí: hoy el CLI arranca sin token y `/health`, `init` y la
  # pantalla de uso funcionan igual. Meter esa guarda aquí sería un cambio de conducta que
  # nadie pidió, y en el arranque — se rechaza lo MALFORMADO, que es el riesgo de inyección.
  case "$TOKEN" in
    *[!A-Za-z0-9._~+/=-]*)
      echo "· TOKEN_MAL_FORMADO · \`$TOKFILE\` no es un token utilizable." >&2
      echo "    admitido: letras, dígitos y . _ ~ + / - =   Nada de comillas, espacios ni saltos." >&2
      echo "    ⛔ NO lo envío: con un salto de línea, el fichero de configuración de curl" >&2
      echo "       aceptaría una segunda directiva y la cabecera dejaría de ser una sola." >&2
      exit 1 ;;
  esac
  _CFGLEG="$(umask 077; mktemp)"
  if ! chmod 600 "$_CFGLEG" 2>/dev/null; then
    rm -f "$_CFGLEG"; _CFGLEG=""
    echo "· ⛔ no pude asegurar el modo 600 del fichero del token legado: NO envío el secreto." >&2
    exit 1
  fi
  _m="$(stat -f%Lp "$_CFGLEG" 2>/dev/null || stat -c%a "$_CFGLEG" 2>/dev/null)"
  if [ "$_m" != "600" ]; then
    rm -f "$_CFGLEG"; _CFGLEG=""
    echo "· ⛔ el fichero del token legado quedó en modo ${_m:-desconocido}, no 600: NO envío el secreto." >&2
    exit 1
  fi
  printf 'header = "X-Llminbox-Token: %s"\n' "$TOKEN" > "$_CFGLEG"
}
_cfg_legado
H=(--config "$_CFGLEG")

# ── CAMINO NATIVO: sesión y política por (carril,verbo) ──────────────────────
# El token de arriba es COMPARTIDO por los 15 agentes. Para el camino nativo no
# sirve, y no es una restricción de estilo: un secreto único hace INDISTINGUIBLES a
# los 15, que es exactamente lo que el nativo existe para separar. `X-Llminbox-Token`
# queda para lectura y legado; mutar en nativo exige sesión (contrato @contratosbik,
# ledger llminbox 2026-09-05T19:34:30Z).
SESFILE="${LLMINBOX_SESSION_FILE:-$HOME/.llminbox-session.json}"
PENDIR="${LLMINBOX_PENDING_DIR:-$HOME/.llminbox-pendientes}"

# LA POLÍTICA ES DEL OPERADOR Y ES POR (CARRIL,VERBO). No hay interruptor global, y la
# ausencia es deliberada: el ADR dice «There is no global pilot switch», porque un solo
# flag convierte una migración verbo a verbo en un despliegue de todo o nada — y el día
# que hay que volver atrás, se vuelve entero. Aquí no se admite ni comodín de verbo:
# lo que no esté nombrado es `bridge`.
# 🔑 LA POLÍTICA DEL CLIENTE SÓLO PUEDE ENDURECER, JAMÁS ABLANDAR (RULING
# @contratosbik 2026-09-05T20:08:19Z, cerrando una cota del ADR que yo no había citado:
# «There is no client-side or environment-variable override to bridge»).
# Por eso NO se coge «el primer candidato que exista»: se leen TODOS y gana el MÁS
# ESTRICTO. Con el primero-que-gane, apuntar la variable de entorno a un fichero que
# dijera `bridge` ABLANDABA lo que el operador había puesto en el suyo — que es
# exactamente la puerta que el ADR cierra.
# Y la cota, que es parte del contrato y no un descargo: mientras el servidor no publique
# política, el cliente no tiene contra qué comparar, así que el `native-required` que lee
# es un SUELO QUE ÉL MISMO SE PONE — legítimo, y por eso mismo NO ACREDITA NADA ANTE
# TERCEROS. El día que el gateway exponga política, esto pasa a ser CACHÉ, no fuente.
NATPOLFILES=(); NATPOLORIG=()
[ -n "${LLMINBOX_NATIVE_POLICY:-}" ] && { NATPOLFILES=("${LLMINBOX_NATIVE_POLICY}")
                                          NATPOLORIG=("LLMINBOX_NATIVE_POLICY"); }
