            echo "    ./llmi up"
            echo
            echo "  para revertir (deja la variable VACIA, no apuntando a otro mapa:"
            echo "  uno malo vuelve a tumbar el arranque):"
            echo "    unset LLMINBOX_CREDENCIALES && ./llmi up"
