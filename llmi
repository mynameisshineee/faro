# ── IDENTIDAD DERIVADA DE LA SESIÓN, no tecleada ──────────────────────────────
# Las 45 sesiones de la flota se llaman EXACTAMENTE `<rol>-<carril>`
# (`backend-64bis`, `cfo-guardian-PM`, `wiki-vault-bikeus`…), y eso es una
# identidad ESTABLE: sobrevive al reinicio de la sesión de Claude, al contrario
# que la dirección de peer (`cto-biklabs-97`), cuyo sufijo cambia cada vez.
#
# Por qué importa: todo error de identidad de esta semana nació de TECLEAR —
# `sdet` publicando 5 h al vacío, 149 nombres para 15 roles, un carril tecleado
# con el nombre del ledger que drenaba los 12 cursores. Lo que no se teclea no
# se equivoca. Se DERIVA y se puede desactivar (`BIK_CARRIL`/argumento explícito
# mandan siempre, por si alguien sabe lo que hace).
#
# El corte NO es por el primer guión: hay roles con guión (`cfo-guardian-64bis`,
# `db-migrations-PM`). Se casa el SUFIJO contra los carriles conocidos, que los
# sirve el propio servicio en `/carriles` (y si no responde, el `carriles.tsv`
# de flota) — el mismo SoT que usa el ámbito de carril, no una copia.
_sesion_tmux() {
  [ -n "${TMUX:-}" ] || return 1
  tmux display-message -p '#S' 2>/dev/null | grep -qE '.' || return 1
  tmux display-message -p '#S' 2>/dev/null
}

_carriles_conocidos() {
  curl -sf -m 3 "${H[@]}" "$API/carriles" 2>/dev/null \
    | python3 -c 'import json,sys
try: print("\n".join(json.load(sys.stdin)))
except Exception: pass' 2>/dev/null && return 0
  local tsv="$HOME/AGENTES/agentes_BIK/_shared_refs/carriles/carriles.tsv"
  [ -r "$tsv" ] && awk -F'\t' '!/^#/ && NF>1 {print $1}' "$tsv"
}

# rol y carril de ESTA sesión, o nada si no se puede derivar con certeza.
_yo_y_carril() {
  local ses car rol
  ses="$(_sesion_tmux)" || return 1
  while IFS= read -r car; do
    [ -n "$car" ] || continue
    case "$ses" in
      *-"$car")
        rol="${ses%-$car}"
        [ -n "$rol" ] && { printf '%s\t%s\n' "$rol" "$car"; return 0; } ;;
    esac
  done < <(_carriles_conocidos)
  return 1
}

# Rellena `$1` (nombre de agente) y `$carril` desde la sesión cuando no vienen, y
# AVISA —sin bloquear— cuando lo tecleado no casa con la sesión. El aviso es la
# mitad que de verdad cierra el error: leer la bandeja de otro es legítimo (lo hago
# yo al depurar), pero hacerlo SIN DARTE CUENTA es lo que costó 5 h a `sdet` y 12
# cursores drenados a quien tecleó un nombre de ledger como carril.
_aviso_identidad() {   # $1 = nombre tecleado (o vacío)
  local par rol car
  par="$(_yo_y_carril)" || return 0        # sin tmux resoluble, todo sigue igual
  rol="${par%%$'\t'*}"; car="${par##*$'\t'}"
  YO_DERIVADO="$rol"; CARRIL_DERIVADO="$car"
  if [ -n "${1:-}" ] && [ "$1" != "$rol" ]; then
    echo "· ojo: tu sesión es «$rol-${car}» y estás usando «$1» — si es a propósito, ignora esto" >&2
  fi
  if [ -n "${BIK_CARRIL:-}" ] && [ "$BIK_CARRIL" != "$car" ]; then
    echo "· ojo: BIK_CARRIL=«${BIK_CARRIL}» pero tu sesión es del carril «${car}»" >&2
  fi
}

