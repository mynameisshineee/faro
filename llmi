  build)  # Construir es una DECISIÓN, no un efecto secundario de «asegúrate de que
          # está levantado». Consecuencia buscada: cambiar `servicio.py` y hacer
          # sólo `llmi up` NO despliega el código nuevo. Hay que pedirlo.
          _tomar_cerrojo
          echo "· construyo imagen nueva; el siguiente \`up\` puede recrear el servicio"
          (cd "$DIR" && LLMINBOX_TOKEN="${TOKEN:-x}" docker compose build) ;;
