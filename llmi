          # precheck, un `LLMINBOX_CREDENCIALES` heredado del envfile seguía viajando
          # al compose y el servicio arrancaba CON V8 — o sea que la orden de rollback
          # no hacía lo que su nombre dice. Se fuerza el estado que se pidió.
          if [ "${_sin_v8:-0}" = "1" ]; then
            unset LLMINBOX_CREDENCIALES
            echo "· --sin-v8: arranco con V8 APAGADO a propósito (credencial retirada)"
          fi
