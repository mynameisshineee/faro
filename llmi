              echo "   o reutilizó el contenedor, o aún no ha reabierto, o carga otro fichero." >&2
              echo "   NO sello el aplicado: el próximo \`up\` volverá a recrear, que es lo" >&2
              echo "   correcto. Un sello que va por delante del proceso es peor que no tenerlo." >&2
              echo "   (si tu imagen es anterior a \`v8.mapa_atestado\`, este campo no existe" >&2
              echo "    y hace falta \`llmi build\` — el gate NO se salta por eso)" >&2
              exit 1
            fi
            echo "· atestado: el proceso vivo declara el mapa que se montó"
            # EL SELLO SE ESCRIBE, SE MUEVE **Y SE RELEE**. El `mv` iba dentro de un
            # `{ …; chmod … || true; }` cuyo resultado nadie miraba: si la escritura
            # fallaba, `llmi` seguía, avanzaba `.llmi-applied` y salía 0 SIN sello — y
            # el siguiente `up` comparaba contra una línea base inexistente. Releerlo
            # es lo único que distingue «lo escribí» de «está escrito»: cubre el `mv`
            # fallido, el parcial, y la ruta ocupada por un directorio.
            _hh="${_SNAP_SHA:-}"
            if [ -z "$_hh" ] || ! printf %s "$_hh" > "$_fh.tmp.$$" \
               || ! mv -f "$_fh.tmp.$$" "$_fh" \
               || [ "$(cat "$_fh" 2>/dev/null)" != "$_hh" ]; then
              rm -f "$_fh.tmp.$$"
              echo "⛔ no pude dejar escrito el sello del mapa en $_fh." >&2
              echo "   NO avanzo el estado aplicado: un \`up\` que dice 0 sin sello deja al" >&2
              echo "   siguiente comparando contra una línea base que no existe." >&2
              exit 1
            fi
            chmod 600 "$_fh" 2>/dev/null || true
          else
            rm -f "$_fh"          # se arrancó sin mapa: no hay cobertura que preservar
          fi
          # ── LOS DOS SELLOS SON UNA SOLA VERDAD ──────────────────────────────
          # Este iba ARRIBA, justo tras `compose up` y ANTES del atestado. Con el
          # atestado en rojo el `up` salía 1 y no escribía el `.sha256`… pero
          # `.llmi-applied` YA había avanzado, así que el siguiente `up` veía
          # `aplicado == deseado`, NO recreaba, y el contenedor se quedaba con el mapa
          # viejo PARA SIEMPRE. El propio mensaje de error prometía «el próximo `up`
          # volverá a recrear» y el código lo desmentía.
          #
          # Es la misma clase que este `up` ya protegía un piso más abajo —«si el BUILD
          # falla el sello no avanza»— reintroducida encima: un sello que va por delante
          # de lo que acredita. Va al FINAL: o avanzan los dos, o ninguno.
          printf %s "$_deseado" > "$_APPLIED.tmp.$$" && mv -f "$_APPLIED.tmp.$$" "$_APPLIED"
