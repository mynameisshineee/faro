          [ -r "$1" ] || { echo "· no puedo leer $1" >&2; exit 2; }
          docker inspect "$LLMINBOX_NAME" >/dev/null 2>&1 \
            || { echo "· ⚠️ NO MEDIDO: el servicio no esta levantado, y sin el no puedo" >&2
                 echo "     validar contra el censo REAL. Arrancalo: llmi up" >&2; exit 3; }
