# ═══ CAMINO NATIVO — cliente de un contrato que TODAVÍA NO TIENE SERVIDOR ═════
# Medido en esta misma base (485d2db): `/sessions /whoami /events /receipts /leases`
# ⇒ 0 rutas en servicio.py, con ⊕ control `/inbox` ⇒ 2 en el mismo fichero, y
# `coordination` ⇒ 0 importaciones. Esto es un CLIENTE escrito contra la letra de
# @contratosbik y probado contra un `curl` falso. Decir que "funciona" antes de que la
# pasarela exista sería el mismo verde mudo que este commit cura tres líneas más abajo.

_REQH=(); _REQEXTRA=(); _RUTA=""; _METODO=""; _SUBCLASE=""; _REQCFG=""; _TIMEOUT=20; _MUTACION=0; _BODYF=""; _HTTP=""; _RCC=0; _CLASE=""
_IDEM=0; _KEY_DERIVADA=0; _RECOVERY="ESCALAR"; _CODE=""; _RETRYABLE=""; _AUDIT=""; _FASE=""

_limpia_cuerpo() { [ -n "${_BODYF:-}" ] && rm -f "$_BODYF" 2>/dev/null; _BODYF=""; return 0; }

_token68_valido() {   # $1 = bearer; puro, no crea fichero ni emite secretos
  local token="$1" cuerpo cola
  cuerpo="${token%%=*}"; cola="${token#"$cuerpo"}"
  case "$token" in
    *[!A-Za-z0-9._~+/=-]*|"") return 1 ;;
    *) case "$cuerpo" in
         ""|*[!A-Za-z0-9._~+/-]*) return 1 ;;
         *) case "$cola" in *[!=]*) return 1 ;; *) return 0 ;; esac ;;
       esac ;;
  esac
}

# EL SECRETO NO PUEDE IR EN LA LÍNEA DE COMANDOS. `-H "Authorization: Bearer <token>"` lo
# mete en el argv de `curl`, y el argv lo lee cualquier proceso del sistema con `ps`. Se
# pasa por un fichero de configuración de curl con modo 600, cuya RUTA sí es pública y su
# contenido no. Vale para el token de sesión y para la credencial de workload.
_cfg_auth() {   # $1 = el secreto → deja la ruta del config en $_REQCFG
  _limpia_cfg
  # 🔒 EL CHARSET SE VALIDA ANTES DE CREAR NADA. Rechazar despues de escribir el fichero
  # deja una ventana en la que el secreto malformado YA esta en disco; y el orden importa
  # tambien para leerlo: primero se decide si se envia, luego se prepara.
  # token68 (RFC 6750) es `1*( ALPHA / DIGIT / "-" / "." / "_" / "~" / "+" / "/" ) *"="`:
  # el `=` es RELLENO y sólo va al FINAL. Se comprueba así en vez de admitirlo en cualquier
  # posición, porque afirmar «token68» y aceptar `a=b` sería describir mal lo que valido.
  if ! _token68_valido "$1"; then
      echo "· CREDENCIAL_MAL_FORMADA · la credencial no es un token68 válido." >&2
      echo "    admitido: letras, dígitos y . _ ~ + / -   con \`=\` SÓLO como relleno final" >&2
      echo "    ⛔ NO la envío: con una comilla o un salto de línea, el fichero de configuración" >&2
      echo "       de curl aceptaría una SEGUNDA directiva y la cabecera dejaría de ser una sola." >&2
      echo "    revisa el fichero: un pegado con salto de línea al final basta para esto." >&2
      # rc=1, no 6. MISMA clase de fallo que el fichero malformado que se caza al cargar, y
      # que la política ilegible y el token del watcher vacío: CONFIGURACIÓN LOCAL ROTA.
      # El `6` significa «el servidor rechazó con un code» — usarlo aquí le colgaría al
      # servidor un fallo que es de esta máquina y que ni le ha llegado.
      # DEVUELVE, no `exit`: matar aquí dejaba la rama `CREDENCIAL_NO_ASEGURABLE` de
      # `_exige_workload` INALCANZABLE — código muerto que dos falsadores llevaban
      # marcando en rojo desde antes de este commit.
      return 1
  fi

  # PERMISOS FAIL-CLOSED. `chmod … || true` dejaba el secreto en un fichero legible por
  # todos si el chmod fallaba — la dirección peligrosa. Se crea con `umask 077`, se
  # comprueba el modo REAL, y si no es 600 se borra y se para: mejor sin publicar que
  # publicando con el secreto a la vista.
  _REQCFG="$(umask 077; mktemp)"
  if ! chmod 600 "$_REQCFG" 2>/dev/null; then
    rm -f "$_REQCFG"; _REQCFG=""
    echo "· ⛔ no pude asegurar el modo 600 del fichero de credencial: NO envío el secreto." >&2
    return 1
  fi
  _modo="$(stat -f%Lp "$_REQCFG" 2>/dev/null || stat -c%a "$_REQCFG" 2>/dev/null)"
  if [ "$_modo" != "600" ]; then
    rm -f "$_REQCFG"; _REQCFG=""
    echo "· ⛔ el fichero de credencial quedó en modo ${_modo:-desconocido}, no 600: NO envío el secreto." >&2
    return 1
  fi
  # 🩸 INYECCIÓN EN EL CONFIG. `header = "…%s…"` interpola el secreto DENTRO de un valor
  # entrecomillado: un token con `"` cierra la cadena, y con CR/LF abre una LÍNEA nueva —
  # o sea, una segunda directiva de curl (`header = "X: y"`, o peor, `output = …`). El
  # secreto viene de un fichero que el operador escribe a mano: no es hostil por diseño,
  # pero un pegado con salto de línea basta.
  #
  # CHARSET CERRADO, fail-closed: los bearer tokens son `token68` (RFC 6750) —
  # [A-Za-z0-9._~+/-] con `=` de relleno al final. Nada de comillas, barras invertidas ni
  # control. Lo que no encaje NO se envía: es más seguro negarse que escapar bien.
  printf 'header = "Authorization: Bearer %s"\n' "$1" > "$_REQCFG"
}
_limpia_cfg() { [ -n "${_REQCFG:-}" ] && rm -f "$_REQCFG" 2>/dev/null; _REQCFG=""; return 0; }

# El encadenado del trap vive ARRIBA (junto al primer `trap` del arranque). Aquí sólo se
# añade la limpieza del fichero de credencial del camino nativo, SIN pisar lo que ya haya.
_encadena_trap_salida '_limpia_cfg'

# ── SESIÓN EFÍMERA DEL OPERADOR DE ADMISIÓN ─────────────────────────────────
# La barrera de admisión mueve la puerta de ESCRITURA de TODA la flota: blast radius
# mayor que cualquier otro verbo nativo. Por eso NO reutiliza `SESFILE` (sesión
# INTERACTIVA de uso continuo en `lease`/`post`/`whoami`) ni `WLFILE` (abre ESA sesión y
# es compartida por quien haga `session open`): usa una credencial DEDICADA (`OPFILE`)
# que abre una sesión de UN SOLO USO por comando — se abre, se hace el trabajo, y se
# REVOCA por el trap EXIT (corre TAMBIÉN en el camino de error) — nunca queda viva en
# disco ni sobrevive al proceso que la usó. El token NUNCA se imprime ni se persiste:
# vive sólo en memoria (`_OPSES_TOKEN`) y en el fichero 600 de un solo uso de `_cfg_auth`.
OPFILE="${LLMINBOX_OPERATOR_CREDENTIAL_FILE:-$HOME/.llminbox-operator.credential}"
# TTL corto y EXPLÍCITO: esta sesión vive lo que dura UN comando (abrir · whoami · leer ·
# escribir · revocar), nunca la vida de una terminal. `ttl_s` es el mismo nombre de campo
# que ya usa `lease coger` — no se inventa vocabulario nuevo para decir lo mismo.
_OPSES_TTL_S="${LLMINBOX_OPERATOR_SESSION_TTL_S:-60}"
_OPSES_TOKEN=""
_opses_revocar() {   # colgado del trap EXIT: si se abrió, se cierra, PASE LO QUE PASE
  local orig=$? t="$_OPSES_TOKEN" _http_del="" _rcc_del=1
  [ -n "$t" ] || return 0
  _OPSES_TOKEN=""                       # primero: si esto mismo falla, no reintenta en bucle
  if _cfg_auth "$t" 2>/dev/null; then
    _http_del="$(curl -s -m 10 -o /dev/null -w '%{http_code}' -X DELETE \
      --config "$_REQCFG" "$API$NAT/sessions/current" 2>/dev/null)"; _rcc_del=$?
    _limpia_cfg
  fi
  # ÉXITO ES LA CONJUNCIÓN, no el código HTTP solo: `curl` puede reportar el 204 recibido
  # Y AUN ASÍ salir con rc≠0 (p. ej. el cuerpo se corta después de las cabeceras) — eso NO
  # es una revocación honesta, es una que no se puede acreditar. Y el 204 es el contrato
  # ya en uso para esta misma ruta (ver `session revoke` / el stub de pruebas): un 200 o
  # un 202 no son "casi lo mismo", son una FORMA que este camino no pidió.
  if [ "$_rcc_del" = "0" ] && [ "$_http_del" = "204" ]; then
    return 0                            # revocada de verdad: silencio está bien
  fi
  # 🩸 NO ES `|| true` SILENCIOSO: una sesión de operador que no se pudo revocar sigue
  # VIVA con la capacidad de mover la barrera de TODA la flota, y nadie se entera si esto
  # no avisa. Si el comando iba a salir 0 (limpio), se ESCALA a 8 — la misma familia que
  # ya usa este CLI para «el efecto quedó persistido pero una garantía POSTERIOR no se
  # puede acreditar»: la transición ya está hecha; lo que no se pudo confirmar es el cierre.
  echo "· ⚠️  ADMISSION_SESION_NO_REVOCADA · la sesión efímera de operador puede seguir VIVA" >&2
  echo "    (DELETE $NAT/sessions/current ⇒ curl rc=$_rcc_del · HTTP ${_http_del:-sin respuesta})." >&2
  echo "    NO la des por cerrada: revócala a mano o espera a que venza (ttl=${_OPSES_TTL_S}s)" >&2
  echo "    antes de volver a operar la barrera con esta credencial." >&2
  [ "$orig" = "0" ] && exit 8
  return 0
}
_encadena_trap_salida '_opses_revocar'

# $1=qué se intentaba. Lee la credencial por UN SOLO fd — nunca por pathname (`[ -r ]`,
# `cat`, `awk`, `tr` reabren la ruta y dejan una ventana TOCTOU: un symlink puede
# sustituir el destino ENTRE la comprobación y la lectura). `O_NOFOLLOW` rechaza un
# enlace en la propia ruta, `O_NONBLOCK` impide que un FIFO cuelgue la apertura,
# `O_CLOEXEC` evita que el descriptor viaje a `curl`. El `fstat` (del DESCRIPTOR, no de
# la ruta) exige regular + tu uid + modo 600 EXACTO — mismo rigor que `_sesion_cargar`
# para el fichero de sesión interactiva, aplicado aquí porque esta credencial es más
# sensible: abre la puerta de escritura de la flota ENTERA, no la de un solo agente.
# Gate LOCAL, ANTES de `vivo` y de cualquier red: si esto falla, CERO bytes han salido.
_opses_credencial() {
  local salida rc
  salida=$(LLMI_OPFILE="$OPFILE" python3 - <<'EOPY'
import errno, os, stat, sys

RUTA = os.environ["LLMI_OPFILE"]
TOPE = 4096                              # una credencial son ~50-100 B; holgura, no límite fino

def malo(msg):
    print("· CREDENCIAL_MAL_FORMADA · %s" % msg, file=sys.stderr)
    print("    ⛔ NO la envío: no leo ni uso una credencial que no pasa este control.", file=sys.stderr)
    raise SystemExit(1)

flags = os.O_RDONLY
for _n in ("O_NOFOLLOW", "O_CLOEXEC", "O_NONBLOCK"):
    _b = getattr(os, _n, 0)
    if not _b:
        malo("esta plataforma no ofrece `%s`: NO abro la credencial de operador." % _n)
    flags |= _b
try:
    fd = os.open(RUTA, flags)
except FileNotFoundError:
    raise SystemExit(3)                  # ausente: mensaje lo pone el shell (caso legítimo)
except OSError as e:
    if e.errno in (errno.ELOOP, errno.EMLINK):
        malo("`%s` es un ENLACE SIMBÓLICO (o apunta a uno): no lo abro." % RUTA)
    malo("no pude abrir `%s`: %s." % (RUTA, e.strerror))

try:
    st = os.fstat(fd)                    # DEL DESCRIPTOR, no de la ruta
    if not stat.S_ISREG(st.st_mode):
        malo("`%s` no es un fichero regular: no lo abro." % RUTA)
    # EFECTIVO, no real: el permiso que el kernel comprueba de verdad es `geteuid()` —
    # bajo un setuid (no es el caso hoy, pero comparar contra el uid EQUIVOCADO es la
    # clase de descuido que sólo se nota el día que sí lo es.
    if st.st_uid != os.geteuid():
        malo("`%s` pertenece al uid %d, no al tuyo (euid %d)." % (RUTA, st.st_uid, os.geteuid()))
    modo = stat.S_IMODE(st.st_mode)
    if modo != 0o600:
        malo("`%s` está en modo %o, no 600: NO leo la credencial." % (RUTA, modo))
    if st.st_size > TOPE:
        malo("`%s` pasa de %d B: no es una credencial." % (RUTA, TOPE))
    # LEE HASTA `st_size`, EN BUCLE — un solo `os.read()` no está garantizado a devolver
    # el fichero ENTERO de una vez (short read), y confiar en eso es exactamente el tipo
    # de suposición que sólo falla la vez que importa. La longitud se compara CONTRA LA
    # DEL FSTAT, no contra "lo que sea que llegó".
    trozos = bytearray()
    while len(trozos) < st.st_size:
        trozo = os.read(fd, st.st_size - len(trozos))
        if not trozo:
            break
        trozos += trozo
    if len(trozos) != st.st_size:
        malo("`%s`: leí %d de %d B declarados — lectura incompleta, no la uso." % (RUTA, len(trozos), st.st_size))
    # SEGUNDO fstat, MISMO descriptor: si el fichero se sustituyó o se truncó/escribió
    # ENTRE el primer fstat y el fin de la lectura, la identidad (dispositivo+inodo) o los
    # sellos de tamaño/mtime/ctime ya no coinciden — y eso es exactamente la ventana que
    # todo este bloque existe para no dejar abierta.
    st2 = os.fstat(fd)
    if (st.st_dev, st.st_ino, st.st_size, st.st_mtime_ns, st.st_ctime_ns) != \
       (st2.st_dev, st2.st_ino, st2.st_size, st2.st_mtime_ns, st2.st_ctime_ns):
        malo("`%s` cambió MIENTRAS se leía: no uso una credencial movediza." % RUTA)
    crudo = bytes(trozos)
finally:
    os.close(fd)

try:
    cred = crudo.decode("utf-8")
except Exception:
    malo("`%s` no es UTF-8 válido." % RUTA)

if "\r" in cred:
    malo("`%s` lleva CR: admitido, una sola línea con o sin su LF final." % RUTA)
partes = cred.split("\n")
if len(partes) > 2 or (len(partes) == 2 and partes[1] != ""):
    malo("`%s` no es UNA sola línea." % RUTA)
cred = partes[0]
if cred != cred.strip() or any(c.isspace() for c in cred):
    malo("`%s` lleva espacio o control embebido: no es una credencial utilizable." % RUTA)
if not cred:
    raise SystemExit(4)                  # presente y vacío: mensaje lo pone el shell
print(cred)
EOPY
); rc=$?
  case "$rc" in
    0) _OPSES_CRED="$salida"; return 0 ;;
    3) echo "· CREDENCIAL_OPERADOR_AUSENTE · $1: no hay credencial en $OPFILE." >&2
       echo "    qué hacer: pídesela al operador (capacidad \`admission_operator\`) y escríbela" >&2
       echo "               ahí en UNA sola línea (se creará/editará con modo 600)." >&2
       return 1 ;;
    4) echo "· CREDENCIAL_OPERADOR_AUSENTE · $1: $OPFILE existe pero está VACÍO." >&2
       return 1 ;;
    *) return 1 ;;   # el propio script ya dijo por qué (MAL_FORMADA / plataforma), por stderr
  esac
}

# Abre la sesión efímera. $1=qué se intentaba. Exige `_OPSES_CRED` YA cargado por
# `_opses_credencial` (el gate local corre ANTES de `vivo`, en el sitio de llamada — no
# aquí, para que un `admission` con credencial rota no toque ni el `/health`).
# 0 y `_OPSES_TOKEN` puesto · !=0 nada usable (si el fallo es DEL SERVIDOR, `_di_error`
# ya lo dijo y el rc es el suyo).
_opses_abrir() {
  _cfg_auth "$_OPSES_CRED" || return 1
  _REQH=(); _REQEXTRA=(); _TIMEOUT=15; _MUTACION=1
  _req POST "$NAT/sessions" "{\"ttl_s\":$_OPSES_TTL_S}"
  _desenlace
  if [ "$_CLASE" != "OK" ]; then _di_error "$1 · apertura de sesión de operador"; return $?; fi
  _exige_cuerpo "$1 · apertura de sesión de operador" || return 3
  _OPSES_TOKEN="$(_campo_str token)"
  if [ -z "$_OPSES_TOKEN" ]; then
    echo "· RESPUESTA_NATIVA_INCOMPLETA · $1: \`POST $NAT/sessions\` contestó $_HTTP sin \`token\`." >&2
    return 7
  fi
  return 0
}

# Cabecera de la sesión efímera para la petición SIGUIENTE. `_cfg_auth` se re-invoca por
# llamada (regenera su propio fichero 600 de un solo uso): llamar dos o tres veces con el
# MISMO token es seguro, y es justo lo que whoami · GET estado · POST transición necesitan.
_opses_cabecera() { _REQH=(); _cfg_auth "$_OPSES_TOKEN"; }

# La credencial dice ser de "operador de admisión"; esto lo CONFIRMA contra el servidor
# antes de tocar la barrera. `capabilities` tiene que ser EXACTAMENTE `["admission_operator"]`
# —ni de más (una credencial con más capacidades de las que este camino declara no es la
# que se pidió) ni de menos— y `lane` tiene que venir como texto no vacío. $1=fichero-cuerpo
# de `GET whoami`. Imprime el carril y sale 0 si cuadra; sale 1 si no.
_opses_verifica_whoami() {
  python3 - "$1" <<'EOPY'
import json, sys
try:
    d = json.load(open(sys.argv[1]))
    caps, lane = d["capabilities"], d["lane"]
    if not isinstance(caps, list) or caps != ["admission_operator"]:
        raise ValueError
    if not isinstance(lane, str) or not lane:
        raise ValueError
except Exception:
    raise SystemExit(1)
print(lane)
EOPY
}

# NUNCA `-f`. `curl -f` descarta el CUERPO del error, y el cuerpo del error es justo
# donde viaja el `code` del vocabulario cerrado: con `-f` un 409 IDEMPOTENCY_CONFLICT y
# un 403 POLICY_DENIED son el mismo silencio, y son acciones opuestas para quien llama.
_req() {   # $1=método $2=ruta [$3=datos JSON]
  local m="$1" ruta="$2" datos="${3:-}" args
  _limpia_cuerpo; _BODYF="$(mktemp)"
  args=(-s -m "$_TIMEOUT" -X "$m" -o "$_BODYF" -w '%{http_code}')
  [ -n "$datos" ] && args=("${args[@]}" -H 'Content-Type: application/json' -d "$datos")
  args=("${args[@]}" ${_REQEXTRA[@]+"${_REQEXTRA[@]}"})
  [ -n "${_REQCFG:-}" ] && args=("${args[@]}" --config "$_REQCFG")
  _RUTA="$ruta"; _METODO="$m"
  _HTTP="$(curl "${args[@]}" ${_REQH[@]+"${_REQH[@]}"} "$API$ruta" 2>/dev/null)"; _RCC=$?
  case "$_HTTP" in ''|*[!0-9]*) _HTTP="000" ;; esac
  return 0
}

_campo() {   # $1=clave del JSON del cuerpo → su valor, vacío si no está
  [ -n "${_BODYF:-}" ] && [ -s "$_BODYF" ] || return 0
  python3 - "$_BODYF" "$1" <<'EOPY' 2>/dev/null || true
import json,sys
try: d=json.load(open(sys.argv[1]))
except Exception: raise SystemExit
v=d.get(sys.argv[2])
if v is None: raise SystemExit
print(v if not isinstance(v,(dict,list)) else json.dumps(v))
EOPY
}

# LOS BOOLEANOS NO PASAN POR `_campo`. `json.load` devuelve el `bool` de Python y `print`
# lo escribe `True`/`False`, así que `[ "$(_campo retryable)" = "true" ]` es SIEMPRE falso y
# la rama entera nace INERTE — verde mudo, medido por mi mano antes de escribir esto.
# Aquí se emite el literal JSON, y la AUSENCIA se distingue del `false`: sale vacío.
# Importa porque §14.4 lo dice: «la ausencia de `audit_suspended` significa "no suspendida"
# SÓLO DENTRO de un envelope; fuera de él no significa nada».
_campo_bool() {   # $1=clave → "true" | "false" | "" si no está o no es booleano
  [ -n "${_BODYF:-}" ] && [ -s "$_BODYF" ] || return 0
  python3 - "$_BODYF" "$1" <<'EOPY' 2>/dev/null || true
import json,sys
try: d=json.load(open(sys.argv[1]))
except Exception: raise SystemExit
v=d.get(sys.argv[2])
if not isinstance(v,bool): raise SystemExit
print("true" if v else "false")
EOPY
}

_campo_str() {   # $1=clave → texto sólo si el valor JSON es string
  [ -n "${_BODYF:-}" ] && [ -s "$_BODYF" ] || return 0
  python3 - "$_BODYF" "$1" <<'EOPY' 2>/dev/null || true
import json,sys
try: d=json.load(open(sys.argv[1]))
except Exception: raise SystemExit
v=d.get(sys.argv[2])
if not isinstance(v,str): raise SystemExit
print(v)
EOPY
}

_campo_int() {   # $1=clave → entero JSON (un booleano no cuenta como entero)
  [ -n "${_BODYF:-}" ] && [ -s "$_BODYF" ] || return 0
  python3 - "$_BODYF" "$1" <<'EOPY' 2>/dev/null || true
import json,sys
try: d=json.load(open(sys.argv[1]))
except Exception: raise SystemExit
v=d.get(sys.argv[2])
if isinstance(v, bool) or not isinstance(v, int): raise SystemExit
print(v)
EOPY
}

_campo_scalar() {   # $1=clave → string o número JSON; objetos/bools no pasan
  [ -n "${_BODYF:-}" ] && [ -s "$_BODYF" ] || return 0
  python3 - "$_BODYF" "$1" <<'EOPY' 2>/dev/null || true
import json,sys
try: d=json.load(open(sys.argv[1]))
except Exception: raise SystemExit
v=d.get(sys.argv[2])
if isinstance(v, bool) or not isinstance(v, (str, int, float)): raise SystemExit
if isinstance(v, str) and not v: raise SystemExit
print(v)
EOPY
}

# ── BARRERA DE ADMISIÓN: los DOS verbos gateados, cerrados por construcción ──
# `events.accept`/`outbox.requeue` viven en el NÚCLEO (`ADMISSION_VERBS`, coordination.py);
# aquí NO se reinventan como texto libre porque el par es cerrado y el CLI sólo sabe hablar
# de los dos juntos — la transición mueve la PAREJA en un único CAS, nunca un verbo solo.
# Cada fila lleva SU `lane` (como `AdmissionState`, coordination.py): NO hay un `lane` de
# envoltorio del que fiarse — con dos filas de carriles distintos, uno de envoltorio
# escondería justo el desacuerdo que hace falta ver.
_ADMISION_VERBOS='"events.accept","outbox.requeue"'
_ADMISION_ESTADOS='"open","closed","sealed"'

# `$1`=fichero-cuerpo de un GET admission (ya leído) `$2`=sub-verbo del CLI.
# Imprime `{"events.accept":N,"outbox.requeue":M}` (los `expected_epochs` para la
# transición) y sale 0. Sale 7 (RESPUESTA_NATIVA_INCOMPLETA — mismo código que ya usa
# `lease` para un `fencing_token` que falta) si el cuerpo NO trae EXACTAMENTE dos filas,
# una por verbo, sin duplicados ni verbos extra, cada una con `epoch` entero ≥0, `state`
# del vocabulario cerrado y el MISMO `lane` no vacío en las dos — cualquier otra forma es
# un servidor que no cumple el contrato, y no hay CAS seguro que construir sobre eso.
# Sale 2 (MAL USO local, nada más se envía) si `bootstrap` no encuentra las DOS filas en
# `closed`+epoch 0: bootstrap es SÓLO el primer open, y ese par es justo lo que lo
# distingue de un `open` cualquiera — server-side son la MISMA petición, así que sin esta
# guarda un `bootstrap` tecleado por error reabriría un carril maduro sin que nada lo avisara.
_admision_epocas() {
  python3 - "$1" "$2" <<EOPY
import json, sys
VERBOS = ($_ADMISION_VERBOS)
ESTADOS = ($_ADMISION_ESTADOS)
try:
    d = json.load(open(sys.argv[1]))
    filas = d["admissions"]
    if not isinstance(filas, list) or len(filas) != len(VERBOS):
        raise ValueError
    epocas = {}
    lane = None
    for f in filas:
        if not isinstance(f, dict):
            raise ValueError
        v, e, st, ln = f["verb"], f["epoch"], f["state"], f["lane"]
        if v in epocas:
            raise ValueError                      # verbo repetido: forma hostil
        if isinstance(e, bool) or not isinstance(e, int) or e < 0:
            raise ValueError
        if st not in ESTADOS:
            raise ValueError
        if not isinstance(ln, str) or not ln:
            raise ValueError
        if lane is None:
            lane = ln
        elif lane != ln:
            raise ValueError                      # las dos filas tienen que ser del MISMO carril
        epocas[v] = e
    if set(epocas) != set(VERBOS):
        raise ValueError
except Exception:
    raise SystemExit(7)
if sys.argv[2] == "bootstrap" and any(
        f["state"] != "closed" or f["epoch"] != 0 for f in filas):
    raise SystemExit(2)
print(json.dumps(epocas, sort_keys=True))
EOPY
}

# Pantalla humana de un cuerpo de admisión (GET o el resultado de la transición: misma
# forma). `--json` no pasa por aquí — imprime el cuerpo crudo, como el resto del CLI.
# El carril sale de las FILAS (la primera que lo traiga), nunca de un campo de envoltorio
# que `_admision_epocas` ni siquiera exige que exista.
_admision_imprime() {
  python3 - "$1" <<'EOPY'
import json, sys
d = json.load(open(sys.argv[1]))
filas = d.get("admissions", []) or []
lane = next((f.get("lane") for f in filas if f.get("lane")), "?")
print("carril: %s" % lane)
for f in filas:
    print("  %-16s %-8s epoch=%s" % (f.get("verb"), f.get("state"), f.get("epoch")))
EOPY
}

# `$1`=fichero YA validado por `_admision_epocas` (0). Sólo entonces es seguro asumir
# que trae al menos una fila con `lane`; se usa para el cruce contra el carril de whoami.
_admision_lane() {
  python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); print(d["admissions"][0]["lane"])' "$1"
}

# El VALIDADOR de la ESCRITURA, deliberadamente más estricto que el de la LECTURA: un 2xx
# de la transición no se declara éxito sólo por tener la forma general — tiene que ser LA
# forma que la transición pedida PRODUCE. $1=fichero-resultado $2=destino pedido
# $3=epochs PRE (JSON, los `expected_epochs` que se mandaron) $4=lane confirmado por whoami.
# Exige, por CADA fila: `state == destino` · `epoch == epoch_pre(verb) + 1` (el CAS avanzó
# EXACTAMENTE un paso, ni más ni menos) · `lane == $4` (el mismo carril que whoami dijo, no
# uno que el servidor decidiera cambiar a mitad de camino). Sale 0 si TODO cuadra, 1 si no.
_admision_verifica_transicion() {
  python3 - "$1" "$2" "$3" "$4" <<EOPY
import json, sys
VERBOS = ($_ADMISION_VERBOS)
ESTADOS = ($_ADMISION_ESTADOS)
ruta, destino, epocas_pre_raw, lane_esperado = sys.argv[1:5]
try:
    epocas_pre = json.loads(epocas_pre_raw)
    d = json.load(open(ruta))
    filas = d["admissions"]
    if not isinstance(filas, list) or len(filas) != len(VERBOS):
        raise ValueError
    vistos = set()
    for f in filas:
        if not isinstance(f, dict):
            raise ValueError
        v, e, st, ln = f["verb"], f["epoch"], f["state"], f["lane"]
        if v in vistos or v not in VERBOS:
            raise ValueError
        vistos.add(v)
        if isinstance(e, bool) or not isinstance(e, int) or e < 0:
            raise ValueError
        if st not in ESTADOS:
            raise ValueError
        if not isinstance(ln, str) or not ln or ln != lane_esperado:
            raise ValueError
        if st != destino:
            raise ValueError
        if v not in epocas_pre or e != epocas_pre[v] + 1:
            raise ValueError
    if vistos != set(VERBOS):
        raise ValueError
except Exception:
    raise SystemExit(1)
EOPY
}

# Valida la foto/certificado de rollback como UN wire cerrado. `$2` es `status` o
# `certificate`; `$3`, el carril acreditado por whoami. En modo certificate exige además
# la condición que el certificado AFIRMA (ambas puertas sealed y cola exactamente cero):
# un 200 con una forma bonita pero una verdad falsa nunca se imprime como certificado.
_rollback_verifica() {
  python3 - "$1" "$2" "$3" <<EOPY
import json, sys
VERBOS = ($_ADMISION_VERBOS)
ESTADOS = ($_ADMISION_ESTADOS)
ruta, modo, lane_whoami = sys.argv[1:4]
try:
    d = json.load(open(ruta))
    keys = ({"lane", "admissions", "outbox", "durable_v", "certifiable"}
            if modo == "status" else
            {"lane", "admissions", "outbox", "durable_v", "certified_at"})
    if type(d) is not dict or set(d) != keys or d["lane"] != lane_whoami:
        raise ValueError
    if isinstance(d["durable_v"], bool) or not isinstance(d["durable_v"], int) \
            or d["durable_v"] < 1:
        raise ValueError
    rows = d["admissions"]
    if type(rows) is not list or len(rows) != len(VERBOS):
        raise ValueError
    seen = set()
    for row in rows:
        if type(row) is not dict or set(row) != {"lane", "verb", "state", "epoch"}:
            raise ValueError
        verb, state, epoch, lane = (row["verb"], row["state"], row["epoch"], row["lane"])
        if verb not in VERBOS or verb in seen or state not in ESTADOS or lane != lane_whoami:
            raise ValueError
        if isinstance(epoch, bool) or not isinstance(epoch, int) or epoch < 0:
            raise ValueError
        seen.add(verb)
    if seen != set(VERBOS):
        raise ValueError
    out = d["outbox"]
    if type(out) is not dict or set(out) != {"lane", "pending", "failed", "unresolved"} \
            or out["lane"] != lane_whoami:
        raise ValueError
    for key in ("pending", "failed", "unresolved"):
        if isinstance(out[key], bool) or not isinstance(out[key], int) or out[key] < 0:
            raise ValueError
    if out["unresolved"] != out["pending"] + out["failed"]:
        raise ValueError
    derived = all(row["state"] == "sealed" for row in rows) and out["unresolved"] == 0
    if modo == "status":
        if not isinstance(d["certifiable"], bool) or d["certifiable"] != derived:
            raise ValueError
    elif (modo != "certificate" or not isinstance(d["certified_at"], str)
          or not d["certified_at"] or not derived):
        raise ValueError
except Exception:
    raise SystemExit(1)
EOPY
}

_rollback_imprime() {
  python3 - "$1" <<'EOPY'
import json, sys
d = json.load(open(sys.argv[1])); out = d["outbox"]
print("carril: %s" % d["lane"])
for row in d["admissions"]:
    print("  %-16s %-8s epoch=%s" % (row["verb"], row["state"], row["epoch"]))
print("  outbox           pending=%s failed=%s unresolved=%s" %
      (out["pending"], out["failed"], out["unresolved"]))
print("  durable_v:       %s" % d["durable_v"])
if "certifiable" in d:
    print("  certificable:    %s" % ("sí" if d["certifiable"] else "no"))
else:
    print("  certificado_en:  %s" % d["certified_at"])
EOPY
}

# ── QUÉ MUTA Y QUÉ LLEVA CLAVE, POR (MÉTODO, RUTA) — no por bandera a mano ──
# `_MUTACION` era un GLOBAL con defecto `0` puesto en el sitio de llamada: una ruta nativa
# nueva que MUTE y olvide la línea salía clasificada como LECTURA, y su `5xx` como RECHAZO
# en vez de AMBIGUO. Fail-open, y en la dirección que DUPLICA.
# Aquí el defecto es MUTACIÓN: lo que no se reconoce se trata como si escribiera.
# `idem` = la ruta lleva `Idempotency-Key` ⇒ es la ÚNICA donde repetir es seguro (§14.2:
# `idempotency_key` sólo existe en `accept_event`; las demás no tienen fila de idempotencia).
_clasifica_ruta() {   # $1=método $2=ruta → deja _MUTACION y _IDEM (0/1) y _RECOVERY
  _IDEM=0; _RECOVERY="ESCALAR"
  case "$2" in
    "$NAT"/*)
      case "$1 $2" in
        "POST $NAT/events")  _MUTACION=1; _IDEM=1; _RECOVERY="REINTENTO_MISMA_CLAVE" ;;
        GET*)                _MUTACION=0; _RECOVERY="LECTURA" ;;
        *)                   _MUTACION=1 ;;   # POST/PUT/DELETE nativos: mutan, sin clave
      esac ;;
    *) case "$1" in GET) _MUTACION=0; _RECOVERY="LECTURA" ;; *) _MUTACION=1 ;; esac ;;
  esac
  return 0
}

# CUATRO desenlaces, y el tercero existe para no confundirse con el cuarto:
#   OK        2xx
#   RECHAZO   el servidor contestó y dijo que NO  → trae `code`, no reintentes a ciegas
#   AMBIGUO   la petición SALIÓ y no sé qué pasó  → JAMÁS caer a local: duplicaría
#   SIN_ENVIO no llegó a salir                    → aquí SÍ se sabe que no pasó nada
# 🔑 Un 5xx sobre una MUTACIÓN es AMBIGUO, no rechazo: el servidor pudo escribir y
#    morir al contestar. Tratarlo como "no pasó nada" es cómo se duplica un efecto.
_desenlace() {
  # La clase de la ruta la pone la TABLA, no la bandera que alguien recordó escribir.
  [ -n "${_METODO:-}" ] && _clasifica_ruta "$_METODO" "$_RUTA"
  _CODE="$(_campo code)"; _RETRYABLE="$(_campo_bool retryable)"; _AUDIT="$(_campo_bool audit_suspended)"
  _FASE=""
  case "$_RCC" in
    0)   ;;
    2|3|5|6|7) _CLASE="SIN_ENVIO"; return 0 ;;   # argumentos · URL · proxy · DNS · conexión rechazada
    *)   # 🔑 §14.4 · CAÍDA DE TRANSPORTE: no hay envelope. Ni `code`, ni `retryable`, ni
         # `receipt`. «Mutación sin envelope» ≡ `MUTATION_OUTCOME_UNKNOWN`, y el cliente NO
         # puede tratar la ausencia de respuesta como fracaso.
         # ⛔ Y la ausencia de `audit_suspended` aquí NO significa «no suspendida»: fuera de
         # un envelope no significa NADA. Por eso `_AUDIT` se deja vacío, no "false".
         _CLASE="AMBIGUO"; _FASE="DESCONOCIDA"
         if [ "$_MUTACION" = "1" ]; then _SUBCLASE="MOU_SIN_ENVELOPE"; fi
         return 0 ;;
  esac
  case "$_HTTP" in
    2*)  _CLASE="OK" ;;
    000) # Sin respuesta: mismo caso que el de arriba — no hay envelope que leer.
         _CLASE="AMBIGUO"; _FASE="DESCONOCIDA"
         [ "$_MUTACION" = "1" ] && _SUBCLASE="MOU_SIN_ENVELOPE" ;;
    # UN 404 DICE DOS COSAS OPUESTAS Y SE PARTE POR SUPERFICIE + CÓDIGO TIPADO
    # (hallazgo de @design 20:42:01Z). Sobre una ruta que SIEMPRE debe existir, un 404 es
    # «esta build no expone la pasarela nativa» — y hoy es el ÚNICO estado alcanzable, con
    # 0 rutas nativas en las 4 ramas. Sobre un RECURSO, «no existe» sí es la respuesta.
    # Sin partirlo, el mensaje era «el servidor te rechazó: mira el cuerpo» y el cuerpo
    # decía `Not Found`: un callejón que manda a buscar un permiso o un nombre cuando lo
    # que falta es el camino entero.
    404) case "$_RUTA" in
           # ESTRUCTURAL, POR PREFIJO, NO POR LISTA EXACTA (D9). La lista anterior nombraba
           # 4 rutas; las 10 nativas reales dan 404 cuando no hay pasarela, así que 6 de 10
           # verbos mandaban al operador a «comprobar el identificador» cuando lo que falta
           # es la superficie entera. Medido por @cto-llminbox sobre las 10 rutas.
           # Por prefijo cubre las 10 Y LAS FUTURAS: una ruta nativa nueva nace clasificada.
           #
           # Con la pasarela presente, `SUBJECT_NOT_FOUND` distingue un recurso ausente.
           # Sin ese código tipado, un 404 bajo el prefijo no acredita que exista gateway.
           "$NAT"/*) if [ "$_CODE" = "SUBJECT_NOT_FOUND" ]; then
                        _CLASE="RECHAZO"; _SUBCLASE="NO_EXISTE"
                      else
                        _CLASE="SIN_ENVIO"; _SUBCLASE="GATEWAY_AUSENTE"
                      fi ;;
           *)        _CLASE="RECHAZO";  _SUBCLASE="NO_EXISTE" ;;
         esac ;;
    # 503 NO es un 5xx cualquiera: dice «existo y NO estoy listo», que es un estado del
    # SERVICIO y no un fallo de lo que pediste. Se separa para no mandar a depurar la
    # petición cuando lo que toca es esperar o mirar el despliegue.
    # 🔑 Y AUN ASÍ SIGUE SIENDO AMBIGUO EN UNA MUTACIÓN: «no estoy listo» puede llegar
    # DESPUÉS de haber escrito. Separar el mensaje no puede relajar la regla anti-duplicado.
    # ── §14.1 · LOS DOS CUERPOS DEL WIRE, CASADOS POR TUPLA COMPLETA ─────────
    # El `503` NO se parte por el status: `R3` y el `5xx` de mutación llegan con el MISMO
    # código HTTP y mandan acciones CONTRARIAS. Se casa el CONJUNTO, y sobra un solo campo
    # para que deje de ser `R3`. Sin esto, «casa R3» se cumple casando TODO `503`.
    503|500)
         if [ "$_CODE" = "SERVICE_UNAVAILABLE" ] && [ "$_RETRYABLE" = "true" ] \
            && [ "$(_campo receipt)" = "unavailable" ]; then
           # §14.4 ①: si el sustrato impide resolver la credencial o auditar, R3 GANA. Va
           # PRIMERO por eso: sin orden, `UNKNOWN` sobre un sustrato caído convierte un 503
           # diagnosticable en una ambigüedad permanente.
           # §14.1: `R3` es por OPERACIÓN, no por estado — cierra lo que cierre, y la
           # petición NO llegó al núcleo ⇒ nada se escribió.
           _SUBCLASE="R3_SUSTRATO"; _FASE="ANTES"
           if [ "$_MUTACION" = "1" ]; then _CLASE="AMBIGUO"; else _CLASE="RECHAZO"; fi
         elif [ "$_CODE" = "MUTATION_OUTCOME_UNKNOWN" ]; then
           # §14.1: NO lleva `audit_suspended` — la pasarela no sabe si el núcleo escribió,
           # luego tampoco si la auditoría escribió. Si viene, es que el emisor no cumple.
           _SUBCLASE="MOU"; _FASE="DESCONOCIDA"; _CLASE="AMBIGUO"
         else
           # 5xx sin tupla reconocible. §14.2: un 5xx de mutación que no se puede clasificar
           # por fase es MUTATION_OUTCOME_UNKNOWN, y NUNCA `retryable:true` por defecto.
           if [ "$_MUTACION" = "1" ]; then _CLASE="AMBIGUO"; _SUBCLASE="MOU_INFERIDO"; _FASE="DESCONOCIDA"
           else _CLASE="RECHAZO"; fi
         fi ;;
    5*)  if [ "$_MUTACION" = "1" ]; then _CLASE="AMBIGUO"; _SUBCLASE="MOU_INFERIDO"; _FASE="DESCONOCIDA"
         else _CLASE="RECHAZO"; fi ;;
    *)   _CLASE="RECHAZO" ;;
  esac
  return 0
}

# El `rc` clasifica la ACCIÓN de quien llama; el CUERPO nombra la clase. Multiplicar
# códigos de salida por clase da una tabla que nadie memoriza y que además obliga a
# tocar el contrato cada vez que el núcleo tipa un error nuevo (hoy son 21).
_que_hacer() {
  case "${1:-}" in
    SESSION_INVALID)           echo "tu sesión no vale: \`llmi login\` otra vez. El token compartido NO abre el camino nativo." ;;
    IDEMPOTENCY_CONFLICT)      echo "misma clave con cuerpo DISTINTO: NO se ha escrito nada. Repite el cuerpo original, o cambia la clave con --key." ;;
    FENCING_CONFLICT)          echo "tu turno venció y otro tomó el relevo: vuelve a adquirirlo (\`llmi lease coger\`), no fuerces." ;;
    LEASE_CONFLICT)            echo "el recurso ya tiene dueño vivo: ni reintentes ni fuerces — espera a que venza o pide el relevo." ;;
    CAUSE_REJECTED)            echo "la causa que citas no es aceptable: revisa el evento padre antes de reenviar." ;;
    LEDGER_NOT_ALLOWED)        echo "tu carril no alcanza ese ledger: es una frontera, no un permiso que puedas subir." ;;
    JOURNAL_READ_ONLY)         echo "el diario está en sólo-lectura: no reintentes, avisa al operador." ;;
    COMMAND_REVISION_CONFLICT) echo "esa revisión ya existe: el cuerpo trae el command_id original — continúa sobre él." ;;
    DELIVERY_CONFLICT)         echo "tu rol no está entre los destinatarios de ese evento." ;;
    ATTRIBUTION_REJECTED)      echo "has mandado un campo de atribución: la identidad la pone el servidor, quítalo del cuerpo." ;;
    POLICY_DENIED)             echo "la política del operador no te otorga ese verbo en este carril." ;;
    ADMISSION_CONFLICT)        echo "la barrera cambió bajo tus pies (epoch stale) o ese destino no transita desde el estado actual: \`llmi admission status\` y repite con el epoch fresco." ;;
    ADMISSION_CLOSED)          echo "la admisión de ese verbo está cerrada para tu carril: eso NO lo mueve \`admission\` — lo abre un operador (\`llmi admission open\`)." ;;
    # 409, NO 422 (native_gateway.py:497, tabla \`_ERRORS\`): el destino/reason_code/
    # expected_epochs no encajan en el vocabulario o la forma cerrada del núcleo.
    OPERATION_INVALID)         echo "el destino, el motivo o los epochs esperados no encajan en el vocabulario cerrado del núcleo: revisa \`llmi admission status\` antes de repetir." ;;
    SCHEMA_TOO_NEW)            echo "tu cliente es más viejo que el servidor: actualiza \`llmi\`." ;;
    # §14.1 · UNO para los 12 estados del sustrato, y el cuerpo viene VACÍO A PROPÓSITO: el
    # detalle no se pierde, va al SENSOR del operador. Mandar a «mirar el cuerpo» aquí es
    # mandar a mirar donde por diseño no hay nada.
    SERVICE_UNAVAILABLE)       echo "el sustrato del servicio NO está disponible y la petición no llegó al núcleo: NADA se escribió. \`retryable:true\` dice que repetir es SEGURO, no que vaya a funcionar — espera (5s, 15s, 45s) y para a los 3 intentos. El motivo concreto NO está en este cuerpo a propósito: vive en el sensor del operador." ;;
    # §14.1 · el único envelope cuyo significado entero es «no lo sé». §14.2: `retryable`
    # es `false` en toda mutación que no sea `POST /events` repetida con el MISMO `scope` y
    # el MISMO `req_hash` v3 — NO «misma clave y mismo cuerpo», que es más estrecho de lo
    # que el contrato exige: `req_hash` v3 no cubre el `fencing_token`, así que una petición
    # que cambia SÓLO ese campo sigue siendo un REPLAY y no un efecto nuevo.
    # Y por qué el consejo dice «PUEDE» y no «ES»: sin prueba del resultado histórico esto
    # es un RIESGO, no un hecho — afirmar la certeza es lo que se midió falso. La acción no
    # se relaja por eso: sigue siendo NO repitas y ESCALAR, nunca reconciliar.
    MUTATION_OUTCOME_UNKNOWN)  echo "el servidor NO pudo determinar si tu mutación entró. Mira \`retryable\`: si es \`false\`, NO repitas — ESCALA al operador con el recurso delante. Repetir donde no hay clave de idempotencia PUEDE producir un SEGUNDO EFECTO." ;;
    # ⛔ EL ÚNICO CÓDIGO CUYO CONSEJO ES **NO ACTUAR**. El servidor dice que no puede
    # verificar si tu intento ya entró: con una clave NUEVA lo escribirías OTRA VEZ, y con
    # la misma no sabe. Aquí «reintentar» y «cambiar la clave» son las DOS formas de
    # duplicar, así que se ESCALA. Sin esta fila caía en la rama genérica («mira el
    # cuerpo»), que ante este código es exactamente el consejo equivocado.
    REPLAY_UNVERIFIABLE)       echo "ESCALA al operador con la Idempotency-Key delante. NO reintentes y NO cambies la clave: con una nueva lo escribirías dos veces, y con la misma el servidor ya ha dicho que no puede decidirlo." ;;
    *)                         echo "no reintentes a ciegas: mira el cuerpo de la respuesta." ;;
  esac
}

_di_error() {   # $1=qué se intentaba. Imprime CLASE · QUÉ PASÓ · QUÉ HACER.
  local que="$1" code detalle
  code="$(_campo code)"; detalle="$(_campo detail)"
  [ -n "$detalle" ] || detalle="$(_campo message)"
  case "$_CLASE" in
    SIN_ENVIO)
      if [ "$_SUBCLASE" = "GATEWAY_AUSENTE" ]; then
        echo "· GATEWAY_AUSENTE · $que: esta instancia responde, pero NO expone la pasarela nativa" >&2
        echo "    ($_RUTA ⇒ 404). NADA se ha enviado, y no es un permiso ni un nombre mal escrito." >&2
        echo "    qué hacer: usa una build con la pasarela, o que el operador mueva este (carril,verbo)" >&2
        echo "               a \`bridge\`. No busques el fallo en tu credencial: no ha llegado a mirarse." >&2
      else
        echo "· SIN_GATEWAY · $que: no hay pasarela nativa en $API (curl rc=$_RCC) — NADA se ha enviado." >&2
        echo "    qué hacer: levanta el servicio (\`llmi up\`), o que el operador mueva este (carril,verbo) a \`bridge\`." >&2
      fi
      return 5 ;;
    AMBIGUO)
      case "$_SUBCLASE" in
        R3_SUSTRATO)
          echo "· SERVICE_UNAVAILABLE · $que: el sustrato NO está disponible (503) y la petición NO llegó al núcleo." >&2
          echo "    ⚠️ Aun así lo trato como AMBIGUO: separar el mensaje no puede relajar el anti-duplicado." >&2 ;;
        MOU|MOU_INFERIDO)
          echo "· MUTATION_OUTCOME_UNKNOWN · $que: el servidor NO pudo determinar si tu mutación entró." >&2 ;;
        MOU_SIN_ENVELOPE)
          echo "· MUTATION_OUTCOME_UNKNOWN · $que: NO hubo respuesta con envelope (curl rc=$_RCC · HTTP $_HTTP)." >&2
          echo "    §14.4: «mutación sin envelope» ≡ desenlace desconocido. La AUSENCIA de respuesta NO es un fracaso," >&2
          echo "    y la ausencia de \`audit_suspended\` aquí no significa «no suspendida»: fuera de un envelope no dice nada." >&2 ;;
      esac
      echo "· AMBIGUO · $que: la petición SALIÓ y no sé el desenlace (curl rc=$_RCC · HTTP $_HTTP)." >&2
      echo "    ⛔ NO caigo a publicación local: si la primera entró, el local la DUPLICA." >&2
      # 🔑 §14.2 · EL CONSEJO DE REPETIR SÓLO DONDE HAY CLAVE. `Idempotency-Key` viaja en UNA
      # ruta —`POST /events`— y antes esta frase se imprimía a las SIETE mutaciones: prometía
      # un mecanismo que en seis de ellas no está en la petición. Y con `--key` la atadura
      # clave↔cuerpo la afirma el operador, no la construye este cliente ⇒ tampoco se aconseja.
      if [ "$_IDEM" = "1" ] && [ "${_KEY_DERIVADA:-0}" = "1" ] && [ -n "${IDEM_KEY:-}" ]; then
        echo "    qué hacer: repite el MISMO comando. La clave de idempotencia se deriva del contenido," >&2
        echo "               así que sale idéntica y el servidor devolverá el original (\`replayed\`)." >&2
        echo "    Idempotency-Key: $IDEM_KEY" >&2
      else
        echo "    ⛔ Y NO te digo que repitas: esta ruta NO lleva \`Idempotency-Key\` derivada del cuerpo," >&2
        echo "       así que un segundo intento PUEDE producir un SEGUNDO EFECTO (retryable=false)." >&2
        echo "    qué hacer: ESCALA al operador con la operación y el recurso delante. Leer el estado" >&2
        echo "               AHORA no prueba lo que pasó ENTONCES: vencimiento y relevo borran la evidencia." >&2
        [ -n "${IDEM_KEY:-}" ] && echo "    (clave puesta a mano con --key: $IDEM_KEY — la atadura con el cuerpo la afirmas tú)" >&2
      fi
      # 7, no 6. Son ACCIONES OPUESTAS del que llama y con un solo código no puede
      # decidir sin parsear el cuerpo: un guion que reintente el rechazo duplica trabajo
      # ante un 409, y uno que NO reintente el ambiguo abandona una escritura que quizá
      # aterrizó. (RULING @contratosbik 20:08:19Z, enmendando mi 6 único.)
      return 7 ;;
    *)
      if [ "$_SUBCLASE" = "NO_EXISTE" ]; then
        echo "· NO_EXISTE · $que: el recurso no está ($_RUTA ⇒ 404)." >&2
        echo "    qué hacer: comprueba el identificador. Aquí «no existe» SÍ es la respuesta," >&2
        echo "               no la ausencia de la pasarela." >&2
        return 6
      fi
      echo "· ${code:-HTTP_$_HTTP} · $que: ${detalle:-el servidor rechazó la petición (HTTP $_HTTP)}" >&2
      echo "    qué hacer: $(_que_hacer "${code:-}")" >&2
      return 6 ;;
  esac
}

# ── UN VEREDICTO SÓLO SE EMITE DESDE UNA RESPUESTA QUE LLEGÓ ─────────────────
# Lo que había: `out="$(curl -sf …)"; grep -q '✗' <<<"$out" && exit 1 || exit 0`.
# Con 401 o timeout, `out` queda VACÍO, el grep no encuentra nada y sale **0**:
# "integridad OK" sin haber comprobado nada. Y `vivo` no lo tapa — `/health` NO pide
# token, así que un token malo pasa la guarda y muere después, en silencio.
# Reproducido contra la instancia viva el 2026-09-05: /health 200 · /chain/verify 401
# · out=0 bytes · rc=0. ⊕ con token bueno: rc=1 y 5.221 B con ✗.
_exige_cuerpo() {   # $1=qué se pedía. 0 si hay cuerpo utilizable; si no DICE y devuelve 3.
  _desenlace
  if [ "$_CLASE" = "OK" ] && [ -s "$_BODYF" ]; then return 0; fi
  # LA CLASIFICACIÓN DEL 404 TAMBIÉN TIENE QUE LLEGAR A LOS VERBOS DE LECTURA.
  # Cazado por mis propios tests de D9: `_di_error` sólo lo alcanzan los verbos que MUTAN,
  # así que `whoami`, `recibo` y compañía caían en el genérico «no he verificado NADA» y la
  # regla estructural no servía de nada donde más se nota — son los verbos que un operador
  # usa primero para averiguar qué pasa.
  if [ "$_HTTP" = "404" ] && [ "$_SUBCLASE" = "GATEWAY_AUSENTE" ]; then
    echo "· GATEWAY_AUSENTE · $1: esta instancia responde, pero NO expone la pasarela nativa" >&2
    echo "    ($_RUTA ⇒ 404). No he verificado nada, y no es un permiso ni un nombre mal escrito." >&2
    echo "    qué hacer: usa una build con la pasarela. No busques el fallo en tu credencial:" >&2
    echo "               no ha llegado a mirarse." >&2
    return 3
  fi
  if [ "$_HTTP" = "404" ] && [ "$_SUBCLASE" = "NO_EXISTE" ]; then
    echo "· NO_EXISTE · $1: el recurso no está ($_RUTA ⇒ 404)." >&2
    echo "    qué hacer: comprueba el identificador. Aquí «no existe» SÍ es la respuesta," >&2
    echo "               no la ausencia de la pasarela." >&2
    return 3
  fi
  echo "· NO_PUDE_PREGUNTAR · $1: no he verificado NADA (curl rc=$_RCC · HTTP $_HTTP)." >&2
  case "$_HTTP" in
    401|403) echo "    causa: el token no vale para esta ruta. \`/health\` no pide token — por eso la guarda \`vivo\` pasó." >&2 ;;
    000)     echo "    causa: sin respuesta (timeout o conexión cortada)." >&2 ;;
    2*)      echo "    causa: respuesta VACÍA con HTTP $_HTTP." >&2 ;;
    *)       echo "    causa: HTTP $_HTTP." >&2 ;;
  esac
  echo "    ⛔ esto NO es un verde: es la AUSENCIA de medida. El markdown sigue donde estaba." >&2
  return 3
}

# ── política por (carril,verbo) ──────────────────────────────────────────────
# Deja el modo en $POLITICA. No devuelve por stdout a propósito: un `$( )` se lleva el
# `exit` a un subshell y una política malformada seguiría adelante como si fuera `bridge`
# — que es promover a silencio justo el fichero que el operador escribió para mandar.
_dureza() { case "${1:-}" in bridge) echo 0 ;; native) echo 1 ;; native-required) echo 2 ;; *) echo -1 ;; esac; }

_politica_de() {   # $1=carril $2=verbo
  POLITICA="bridge"
  local f m
  for f in ${NATPOLFILES[@]+"${NATPOLFILES[@]}"}; do
    [ -r "$f" ] || continue
    _politica_de_fichero "$f" "$1" "$2"
    [ "$(_dureza "$_MODO_F")" -gt "$(_dureza "$POLITICA")" ] && POLITICA="$_MODO_F"
  done
  return 0
}

_politica_de_fichero() {   # $1=fichero $2=carril $3=verbo → deja el modo en $_MODO_F
  local NATPOLFILE="$1" m
  _MODO_F="bridge"
  m="$(python3 - "$NATPOLFILE" "${2:-}" "${3:-}" <<'EOPY' 2>/dev/null
import json,sys
try: d=json.load(open(sys.argv[1]))
except Exception: print("__ILEGIBLE__"); raise SystemExit
lanes=d.get("lanes")
if not isinstance(lanes,dict): print("__MALFORMADA__"); raise SystemExit
v=lanes.get(sys.argv[2])
if v is None: print("bridge"); raise SystemExit
if not isinstance(v,dict): print("__MALFORMADA__"); raise SystemExit
print(v.get(sys.argv[3],"bridge"))
EOPY
)"
  case "$m" in
    bridge|native|native-required) _MODO_F="$m"; return 0 ;;
  esac
  # Presente e ilegible NO es "sin política": es un accidente con forma de decisión.
  # Mismo criterio que ya aplica LLMINBOX_POLICY_DIR más arriba, y por el mismo motivo.
  echo "· ⛔ política nativa ilegible, malformada o con un modo desconocido: $NATPOLFILE" >&2
  echo "     leído para ($2,$3): «${m:-<nada>}»   ·   admitidos: bridge · native · native-required" >&2
  echo "     forma: {\"version\":1,\"lanes\":{\"<carril>\":{\"<verbo>\":\"native\"}}}" >&2
  exit 1
}

# ── sesión ───────────────────────────────────────────────────────────────────
# ── EL FICHERO DE SESIÓN SE ABRE UNA VEZ, Y SE AUDITA ESE MISMO DESCRIPTOR ──
# Lo anterior comprobaba por RUTA (`-L`, `-f`, `stat`) y DESPUÉS abría por RUTA otra vez.
# Entre una cosa y otra hay una ventana: cuatro búsquedas de nombre distintas, y en cada
# una el fichero puede ser OTRO. Eso es un TOCTOU de manual — quien pueda escribir en el
# directorio deja un fichero legítimo mientras se comprueba y lo cambia antes de que se
# lea, y la guarda firma un fichero que nunca se abrió.
#
# La cura no es comprobar mejor: es dejar de comprobar POR NOMBRE. Se abre UNA vez con
# `O_NOFOLLOW|O_CLOEXEC`, se hace `fstat` DEL DESCRIPTOR, se lee DE ESE MISMO DESCRIPTOR y
# el resultado se guarda en memoria. Después de eso el nombre ya no se vuelve a usar: da
# igual lo que pase con la ruta, porque el inodo que se validó y el que se leyó son el
# mismo por construcción, no por suerte.
#   O_NOFOLLOW  -> un symlink NO se sigue: falla al abrir. También el COLGANTE, que es el
#                  caso que un `[ -f ]` deja pasar como «no existe» y acaba en «no hay sesión».
#   O_CLOEXEC   -> el descriptor no se hereda a ningún hijo (`curl`, `python3`)
#   fstat       -> regular ∧ uid == el mío ∧ modo == 0600 EXACTO
#   lectura ACOTADA -> un fifo o un fichero enorme no cuelgan ni se comen la memoria
#
# Salidas del cargador: 0 usable · 3 AUSENTE (no hay sesión, que es legítimo) ·
# 1 INSEGURO (ya ha dicho por qué, por stderr) · 4 ilegible o no es JSON de sesión.
_SES_CARGADA=0; _SES_TOKEN=""; _SES_RTI=""; _SES_EXP=""; _SES_GEN=""; _SES_EXISTE=0

_sesion_cargar() {   # deja el SNAPSHOT en memoria. Sale 1 si el fichero es INSEGURO.
  [ "$_SES_CARGADA" = "1" ] && return 0
  local salida rc k v
  # stderr NO se captura: los avisos van directos al usuario y así el token, que viaja por
  # stdout, no puede acabar mezclado con un mensaje de error.
  salida="$(LLMI_SESFILE="$SESFILE" python3 - <<'EOPY'
import errno, json, os, stat, sys

RUTA = os.environ["LLMI_SESFILE"]
TOPE = 65536          # un fichero de sesion son ~200 B; esto es holgura, no un limite fino
CLAVES = ("token", "runtime_instance", "expires_at", "generation")

def insegura(msg, *extra):
    print("· SESION_INSEGURA · %s" % msg, file=sys.stderr)
    for e in extra:
        print("    %s" % e, file=sys.stderr)
    print("    ⛔ NADA se ha enviado y el secreto no se ha leído.", file=sys.stderr)
    raise SystemExit(1)

# O_NONBLOCK es OBLIGATORIO y no es una optimizacion: abrir un FIFO en solo-lectura SE
# BLOQUEA hasta que aparezca un escritor, y eso pasa ANTES de que el `fstat` pueda decir
# «no es regular». Sin esto, un fifo en la ruta de la sesion CUELGA el CLI para siempre en
# vez de rechazarlo — y colgar es PEOR que fallar, porque no deja ni mensaje.
# Lo cazo mi propio falsador del fifo, que dejo la suite corriendo hasta el timeout.
#
# 🩸 Y LOS TRES SON OBLIGATORIOS, ASI QUE SU AUSENCIA FALLA CERRADO. Lo que habia era
# `getattr(os, X, 0)`: si la plataforma no trae el flag, el `0` lo quita del OR y la
# apertura SIGUE ADELANTE degradada — sin O_NOFOLLOW se sigue el enlace que este bloque
# existe para no seguir, sin O_NONBLOCK un fifo cuelga, sin O_CLOEXEC el descriptor viaja
# a `curl`. Los tres defectos son EXACTAMENTE los que aqui se rechazan, y llegaban en
# silencio. Un fail-open invisible es peor que un error: si no puedo abrirlo con las tres
# garantias, NO lo abro.
flags = os.O_RDONLY
for _nombre in ("O_NOFOLLOW", "O_CLOEXEC", "O_NONBLOCK"):
    _bit = getattr(os, _nombre, 0)
    if not _bit:
        insegura("esta plataforma no ofrece `%s`: NO abro el fichero de sesion." % _nombre,
                 "ese flag no es un adorno: sin el, abrir esta ruta deja de ser seguro.",
                 "prefiero parar a leer el token con una garantia menos.")
    flags |= _bit
try:
    fd = os.open(RUTA, flags)
except FileNotFoundError:
    raise SystemExit(3)                       # ausente NO es inseguro: es «no hay sesion»
except OSError as e:
    # ELOOP/EMLINK = es un enlace simbolico (tambien si esta COLGANTE: O_NOFOLLOW falla en
    # el enlace mismo, antes de mirar el destino). Lo demas: no se pudo abrir y no se sabe
    # por que — y no saberlo NO es que este bien.
    if e.errno in (errno.ELOOP, errno.EMLINK):
        insegura("`%s` es un ENLACE SIMBÓLICO (o apunta a uno): no lo abro." % RUTA,
                 "quien controle el enlace elige qué fichero leo — y un enlace COLGANTE",
                 "haría creer que no hay sesión. Bórralo y `llmi login` otra vez.")
    insegura("no pude abrir `%s`: %s." % (RUTA, e.strerror),
             "No poder abrirlo NO es que esté bien: no leo el token.")

try:
    st = os.fstat(fd)                         # DEL DESCRIPTOR, no de la ruta
    if not stat.S_ISREG(st.st_mode):
        insegura("`%s` no es un fichero regular: no lo abro." % RUTA,
                 "un fifo o un dispositivo puede colgar la lectura o dar lo que otro escriba.")
    # Hook de prueba ACOTADO. Lo que decia esta linea —«sólo puede provocar el RECHAZO»—
    # era FALSO: `mio = int(VARIABLE or getuid())` deja que la variable ELIJA el uid
    # ACEPTADO, y quien pueda ponerla en el entorno hace pasar el fichero de otro poniendo
    # el uid de ese otro. Un hook de prueba con una direccion insegura es una puerta.
    # Ahora la variable NO elige nada: si esta puesta, el uid propio pasa a `-1`, que
    # ningun inodo puede tener (`st_uid` no lleva signo). Su unica direccion posible es el
    # RECHAZO, y eso ya es cierto POR CONSTRUCCION y no por promesa del comentario.
    mio = -1 if os.environ.get("LLMI_TEST_FSTAT_UID_FALSO") else os.getuid()
    if st.st_uid != mio:
        insegura("`%s` pertenece al uid %d, no al tuyo (%d)." % (RUTA, st.st_uid, os.getuid()),
                 "que puedas leerlo no lo hace tuyo. NO uso una sesión de otro.")
    modo = stat.S_IMODE(st.st_mode)
    if modo != 0o600:
        insegura("`%s` está en modo %o, no 600: NO leo el token." % (RUTA, modo),
                 "ese token MUTA en tu nombre; con esos permisos ya lo ha podido leer otro.",
                 "qué hacer: `chmod 600 %s`, y si sospechas, `llmi session revoke`." % RUTA)
    crudo = os.read(fd, TOPE + 1)             # ACOTADA, y del MISMO descriptor
    if len(crudo) > TOPE:
        insegura("`%s` pasa de %d B: no es un fichero de sesión." % (RUTA, TOPE))
finally:
    os.close(fd)

try:
    d = json.loads(crudo.decode("utf-8"))
    if not isinstance(d, dict):
        raise ValueError
except Exception:
    raise SystemExit(4)

for k in CLAVES:                              # allowlist: no se emite nada que no sea esto
    v = d.get(k)
    if v is None:
        continue
    v = str(v)
    if "\n" in v or "\t" in v:              # un valor multilinea rompería el formato
        continue
    print("%s\t%s" % (k, v))
EOPY
)"; rc=$?
  case "$rc" in
    1) exit 1 ;;                    # INSEGURO: el cargador ya dijo por qué. Cero petición.
    3) _SES_EXISTE=0; _SES_CARGADA=1; return 0 ;;      # no hay sesión, y es legítimo
    0) _SES_EXISTE=1 ;;
    *) _SES_EXISTE=1 ;;             # ilegible o no es JSON: existe pero no da token
  esac
  while IFS="$(printf '\t')" read -r k v; do
    case "$k" in
      token)            _SES_TOKEN="$v" ;;
      runtime_instance) _SES_RTI="$v" ;;
      expires_at)       _SES_EXP="$v" ;;
      generation)       _SES_GEN="$v" ;;
    esac
  done <<EOSNAP
$salida
EOSNAP
  _SES_CARGADA=1
  return 0
}

# LA PUERTA, EN EL SHELL PADRE — aquí `exit` sí termina el proceso.
# ⚠️ NO se puede llamar desde `$( )`: ahí el `exit` mata la sustitución y no el proceso,
# que es el fail-OPEN que ya me cazó una vez.
_sesion_gate() { _sesion_cargar; }

# Lector del SNAPSHOT. NO vuelve a abrir el fichero: si lo hiciera, reabriría POR RUTA y
# devolvería la ventana que este bloque existe para cerrar.
_sesion_campo() {   # $1=clave
  _sesion_cargar
  case "$1" in
    token)            printf '%s' "$_SES_TOKEN" ;;
    runtime_instance) printf '%s' "$_SES_RTI" ;;
    expires_at)       printf '%s' "$_SES_EXP" ;;
    generation)       printf '%s' "$_SES_GEN" ;;
  esac
  return 0
}

# EL SNAPSHOT SE SIEMBRA CON EL CUERPO QUE ACABA DE LLEGAR — no reabriendo el fichero que
# se acaba de escribir. Reabrir ahi es volver a mirar POR NOMBRE, en la ventana mas corta y
# mas golosa que existe (justo despues de crear el fichero), el unico fichero que un tercero
# querria cambiar. `_BODYF` es un `mktemp` de este proceso y ya esta en la mano: la fuente
# de la verdad para lo que se acaba de guardar es el cuerpo, no la ruta.
_sesion_sembrar_desde_cuerpo() {
  _SES_TOKEN="$(_campo token)"
  _SES_RTI="$(_campo runtime_instance)"
  _SES_EXP="$(_campo expires_at)"
  _SES_GEN="$(_campo generation)"
  _SES_EXISTE=1; _SES_CARGADA=1
  return 0
}

_cabecera_sesion() {   # deja las cabeceras en _REQH; 1 si no hay sesión
  _sesion_gate                       # carga y AUDITA en el shell padre, antes de nada
  local t; t="$_SES_TOKEN"
  [ -n "$t" ] || return 1
  # D8: `Bearer`, no un esquema propio. El ADR §65 llama a estos tokens «bearer
  # credentials» y la pasarela exige `scheme.lower() == "bearer"`. @contratosbik retiró
  # `Llminbox-Session` de su propia tabla: no es un desacuerdo vivo, era letra caducada.
  # 🩸 EL FALLO DE `_cfg_auth` SE PROPAGA. Antes se ignoraba: si no podía asegurar el modo
  # 600, `_REQCFG` quedaba vacío, la petición salía SIN `Authorization` y el 401 se
  # clasificaba como fallo REMOTO — el peor desenlace posible, porque manda a mirar el
  # servidor cuando el problema es local y el secreto ni se envió.
  _REQH=()
  # 2, no 1: «tengo sesión pero NO puedo asegurar su fichero de credencial» NO es «no hay
  # sesión». Con el mismo código, `_exige_sesion` imprimía SIN_SESION_LOCAL señalando un
  # fichero que sí existe y mandaba a `llmi login` — a arreglar lo que no estaba roto.
  _cfg_auth "$t" || return 2
  return 0
}

# BOOTSTRAP: la ÚNICA llamada que usa la credencial de workload, y también con `Bearer`
# (D8 no distingue: el gateway rechaza el legado en todas las rutas nativas). Si no está,
# se PARA — no se cae al token compartido, que es justo la mezcla que esto deshace.
_exige_workload() {   # $1 = qué se intentaba
  if [ -n "$WLCRED" ]; then
    _REQH=()
    if ! _cfg_auth "$WLCRED"; then
      echo "· CREDENCIAL_NO_ASEGURABLE · $1: no pude preparar la credencial con modo 600." >&2
      echo "    NO se ha enviado NADA: sin \`Authorization\` el servidor daría 401 y parecería" >&2
      echo "    un problema suyo. Revisa el directorio temporal y sus permisos." >&2
      return 1
    fi
    return 0
  fi
  echo "· CREDENCIAL_WORKLOAD_AUSENTE · $1: no hay credencial de despliegue en $WLFILE." >&2
  echo "    qué hacer: pídesela al operador y escríbela ahí (se leerá con modo 600)." >&2
  echo "    ⛔ NO caigo al token compartido: con él los 15 agentes abrirían la sesión del" >&2
  echo "       MISMO principal y el diario atribuiría todo a uno solo." >&2
  return 1
}

# BANDERAS FAIL-CLOSED TAMBIÉN AQUÍ (P2-6 de @design). `post` y `lease` rechazaban lo
# desconocido y estos tres verbos lo IGNORABAN: `llmi whoami --ayuda` ejecutaba la petición
# con rc=0, como si el flag no existiera. Mismo binario, dos contratos — y el laxo es el que
# hace creer que pediste algo que nadie leyó. Es la misma clase que `llmi up --buidl`, que
# ya costó un despliegue que el operador creía hecho.
# Va en UNA función y no en tres copias: tres copias del mismo trozo es exactamente cómo
# estos tres se quedaron atrás cuando `post` y `lease` se endurecieron.
# VETO DE FLAGS PARA LOS VERBOS CON POSICIONALES. `_solo_json` no vale aquí: estos verbos
# reciben argumentos que NO son flags (un nombre, un texto de búsqueda, un ledger), así que
# la regla no puede ser «sólo --json» sino «lo que empiece por `-` tiene que estar declarado».
#
# 🩸 POR QUÉ EXISTE: medido con el servicio VIVO —con la API muerta el `rc=3` de `vivo` tapa
# el del flag y el censo miente—, ONCE verbos ignoraban lo desconocido: canon doctor inbox
# lint peek q stat to verify wiki adopcion. El caro es `inbox`, que además AVANZA EL CURSOR:
# un dedazo de flag en el verbo que consume la bandeja no falla, consume.
#
# `--` cierra los flags, que es el escape estándar para un posicional que empiece por `-`
# (p. ej. `llmi q -- -texto-con-guion`).
# Deja en `_ARGS` los argumentos SIN el `--`, porque si no se consume, el verbo lo recibe
# como un posicional: `llmi q -- -texto` acababa buscando la cadena «--».
_ARGS=()
_veta_flags() {   # $1=flags permitidos (separados por espacio) · resto: los argumentos
  local permitidos=" $1 " a fin=0
  shift
  _ARGS=()
  for a in "$@"; do
    if [ "$fin" = "1" ]; then _ARGS=(${_ARGS[@]+"${_ARGS[@]}"} "$a"); continue; fi
    case "$a" in
      --) fin=1; continue ;;
      -*) case "$permitidos" in
            *" $a "*) ;;
            *) echo "· opción desconocida en \`$cmd\`: $a" >&2
               [ "$permitidos" = "  " ] && echo "    este verbo no acepta ninguna opción" >&2 \
                                       || echo "    admitidas:$permitidos" >&2
               echo "    (si es un argumento que empieza por \`-\`, sepáralo con \`--\`)" >&2
               return 1 ;;
          esac ;;
    esac
    _ARGS=(${_ARGS[@]+"${_ARGS[@]}"} "$a")
  done
  return 0
}

_solo_json() {   # deja $_json a 1 si viene --json; 1 (mal uso) ante cualquier otra cosa
  local a
  for a in "$@"; do
    case "$a" in
      --json) _json=1 ;;
      *) echo "· opción desconocida: $a   (este verbo sólo acepta --json)" >&2; return 1 ;;
    esac
  done
  return 0
}

_exige_sesion() {   # $1=qué se intentaba
  _cabecera_sesion; _cs=$?
  [ "$_cs" = 0 ] && return 0
  # `_cfg_auth` ya dijo QUÉ pasó; aquí sólo se añade que nada salió y se propaga rc 1.
  if [ "$_cs" = 2 ]; then
    echo "· CREDENCIAL_NO_ASEGURABLE · $1: NO se ha enviado NADA." >&2
    return 1
  fi
  # Dos causas que compartían línea: NO tener sesión es normal el primer día; tener un
  # fichero INUTILIZABLE es un síntoma, y mandar a `llmi login` sin decirlo esconde que ya
  # hubo un login que salió mal.
  if [ "$_SES_EXISTE" = "1" ]; then
    echo "· SESION_INUTILIZABLE · $1: $SESFILE existe pero no tiene un \`token\` usable." >&2
    echo "    qué hacer: \`llmi login\` otra vez. Si se repite, el servidor devuelve una sesión" >&2
    echo "               sin ese campo y el fallo NO es tuyo." >&2
    # rc 1, no 6: esto lo dice ESTA máquina mirando SU fichero. El `6` significa «el
    # SERVIDOR rechazó con un code del vocabulario», y colgarle a él un fallo local manda
    # a depurar la pieza equivocada — con NADA enviado.
    return 1
  fi
  # NO se llama como un código del wire: esto lo dice ESTA máquina al no encontrar el
  # fichero, no el servidor. `AUTH_REQUIRED` además ni existe en el vocabulario cerrado
  # (`REASON_CODES`, 22) — usarlo aquí hacía creer que había contestado alguien.
  echo "· SIN_SESION_LOCAL · $1: no hay sesión abierta ($SESFILE)." >&2
  echo "    qué hacer: \`llmi login\`. El token compartido NO sirve para el camino nativo:" >&2
  echo "               si sirviera, los 15 agentes serían indistinguibles al mutar." >&2
  return 1
}

# Clave de compatibilidad del BRIDGE/dry-run. El camino nativo la reemplaza por la
# huella de su payload canónico efectivo antes de tocar la red de mutación.
_clave_idem() {   # $1=carril $2=verbo $3=yo $4=destinos $5=tipo $6=titular $7=fichero-cuerpo
  python3 - "$@" <<'EOPY'
import hashlib,sys
a=sys.argv[1:7]
cuerpo=open(sys.argv[7],'rb').read()
h=hashlib.sha256(("\x1f".join(a)).encode('utf-8')+b"\x1e"+cuerpo).hexdigest()
print(h[:32])
EOPY
}

_payload_nativo() {   # usa A TIPO TITULAR CUERPOF; emite el JSON EFECTIVO
  LLMI_DIR="$DIR" python3 - "$A" "$TIPO" "$TITULAR" "$CUERPOF" <<'EOPY'
import contextlib, io, json, os, sys
sys.path.insert(0, os.environ['LLMI_DIR'])
import kind_registry as kr
with contextlib.redirect_stdout(io.StringIO()):
    import ledger_parse as lp
a,tipo,titular,cf=sys.argv[1:5]
payload={"type":"message","verb":"inform",
         "to":[x for x in a.split(",") if x],
         "head":titular,"body":open(cf,encoding="utf-8").read()}
canonical, rev = kr.materialize(tipo)
if canonical is not None:
    payload["canonical_kind"], payload["kind_registry_rev"] = canonical, rev
else:
    payload["kind"] = lp.canonical_tipo(tipo) or tipo
print(json.dumps(payload, ensure_ascii=False, sort_keys=True, separators=(",", ":")))
EOPY
}

_clave_idem_payload() {   # $1 = JSON nativo ya canonicalizado
  python3 - "$1" <<'EOPY'
import hashlib,json,sys
value=json.loads(sys.argv[1])
wire=json.dumps(value,ensure_ascii=False,sort_keys=True,separators=(",",":")).encode()
print(hashlib.sha256(wire).hexdigest()[:32])
EOPY
}

_post_nativo() {   # usa YO A TIPO TITULAR CUERPOF CARRIL IDEM_KEY → 0 ok · 5 sin envío · 6 resto
  _exige_sesion "post nativo" || return $?   # 1 = fallo LOCAL, nada enviado
  local payload rep eid rid r principal role lane
  payload="$(_payload_nativo)" || return 1
  # El servidor ya acota idempotencia por principal/lane/verb. La clave del cliente
  # ata el EFECTO restante: el payload exacto que viaja, no YO ni el lexema previo a
  # canonicalizar. Dos grafías del mismo acto producen el mismo retry.
  [ "$_KEY_DERIVADA" = "1" ] && IDEM_KEY="$(_clave_idem_payload "$payload")"
  case "${LLMINBOX_MESSAGE_POLICY:-off}" in
    off|'') ;;
    *)
      # La politica cliente se evalua contra la identidad que ACABA DE DERIVAR el
      # servidor. Mirar YO aqui validaria el teclado y contradiria /whoami.
      _REQEXTRA=(); _TIMEOUT="${LLMI_TIMEOUT_POST:-30}"; _MUTACION=0
      _req GET "$NAT/whoami"; _desenlace
      if [ "$_CLASE" != "OK" ]; then
        _di_error "identidad para post nativo"; return $?
      fi
      principal="$(_campo_str principal)"; role="$(_campo_str role)"; lane="$(_campo_str lane)"
      if [ -z "$principal" ] || [ -z "$role" ] || [ -z "$lane" ] || [ "$lane" != "$CARRIL" ]; then
        echo "· IDENTIDAD_NATIVA_INVALIDA · /whoami no acredita principal/role/carril esperado." >&2
        return 6
      fi
      python3 "$DIR/message_policy.py" native "$principal" "$role" "$lane" "$TIPO" "$A" \
        || { echo "    ⛔ NO se ha publicado el evento nativo." >&2; return 1; } ;;
  esac
  # EL CUERPO NO LLEVA ATRIBUCIÓN. `yo` sirve para la CLAVE y para los mensajes de esta
  # máquina, y NO se manda: el contrato dice que el servidor RECHAZA —no ignora— todo
  # campo de atribución, y la identidad la deriva él de la sesión. Mandarlo sería pedir
  # un ATTRIBUTION_REJECTED evitable.
  mkdir -p "$PENDIR" 2>/dev/null || true
  # La constancia se escribe ANTES de la red: si la respuesta no llega, esto es lo único
  # que queda para saber que hay algo en vuelo y con qué clave se repite sin duplicar.
  printf '%s\n' "$IDEM_KEY" > "$PENDIR/$IDEM_KEY" 2>/dev/null || true
  # Guarda de array VACIO: `_cabecera_sesion` ya no deja cabeceras en `_REQH` (el secreto
  # va por --config), asi que sin esto `"${_REQH[@]}"` revienta bajo `set -u` en bash 3.2.
  _REQH=(${_REQH[@]+"${_REQH[@]}"} -H "Idempotency-Key: $IDEM_KEY")
  _REQEXTRA=(); _TIMEOUT="${LLMI_TIMEOUT_POST:-30}"; _MUTACION=1
  _req POST "$NAT/events" "$payload"
  _desenlace
  case "$_CLASE" in
    OK)
      rep="$(_campo_bool replayed)"; eid="$(_campo_str event_id)"; rid="$(_campo_str receipt_id)"
      if [ -z "$rep" ] || [ -z "$eid" ] || [ -z "$rid" ]; then
        echo "· RESPUESTA_NATIVA_INCOMPLETA · post nativo: el servidor contestó $_HTTP" >&2
        echo "    pero no trajo event_id, receipt_id y replayed con su tipo contractual." >&2
        echo "    ⛔ NO afirmo éxito ni borro la constancia: el efecto puede existir." >&2
        echo "    qué hacer: ESCALA con Idempotency-Key: $IDEM_KEY; no cambies la clave." >&2
        return 7
      fi
      case "$rep" in
        true) echo "✓ ya estaba publicada — REPLAY: no se ha duplicado nada." ;;
        *)         echo "✓ publicado por el camino NATIVO (autoritativo)." ;;
      esac
      echo "  event_id: ${eid:-?}  ·  receipt_id: ${rid:-?}"
      echo "  Idempotency-Key: $IDEM_KEY"
      rm -f "$PENDIR/$IDEM_KEY" 2>/dev/null || true
      return 0 ;;
    SIN_ENVIO)
      # No se cuenta AQUÍ: si esto es un fallo o una caída legítima al bridge lo decide la
      # POLÍTICA, y quien la conoce es quien llama. Un mensaje aquí diría lo mismo en los
      # dos casos, que son acciones opuestas.
      rm -f "$PENDIR/$IDEM_KEY" 2>/dev/null || true
      return 5 ;;
    RECHAZO)
      _di_error "post nativo"; r=$?
      rm -f "$PENDIR/$IDEM_KEY" 2>/dev/null || true   # dijo que NO: no hay nada en vuelo
      return $r ;;
    *)
      _di_error "post nativo"; return $? ;;           # AMBIGUO: la constancia SE QUEDA
  esac
}

_post_bridge() {   # $1 = por qué salimos por aquí
  case "${LLMINBOX_MESSAGE_POLICY:-off}" in
    off|'') ;;
    *) python3 "$DIR/message_policy.py" bridge "$YO" "$CARRIL" "$TIPO" "$A" \
         || { echo "    ⛔ NO se ha enviado ni escrito nada." >&2; return 1; } ;;
  esac
  echo "· ⚠️  legacy_unverified · BRIDGE LEGADO — esta publicación NO es autoritativa." >&2
  echo "    motivo: $1" >&2
  echo "    aquí \`actor\` es autodeclarado: nadie verifica que quien firma sea quien escribe," >&2
  echo "    y el token es COMPARTIDO por la flota. Sirve como REGISTRO, no como AUTORIDAD." >&2
  LLMI_YO="$YO" LLMI_A="$A" LLMI_TIPO="$TIPO" LLMI_TITULAR="$TITULAR" \
  BIK_CARRIL="$CARRIL" \
  LLMI_MOUNTS="${LLMI_MOUNTS:-$MOUNTS}" LLMI_ROSTER="${LLMI_ROSTER:-$DIR/roster.json}" \
  LLMI_DIR="$DIR" LLMI_CARRILES="${LLMI_CARRILES:-${LLMINBOX_CARRILES:-}}" \
  python3 "$DIR/publicar.py" < "$CUERPOF"
}

cmd="${1:-}"; shift 2>/dev/null || true
# Pedir la ayuda de un subcomando NO es nombrar a un agente: sin esto,
# `llmi inbox --help` acababa pidiendo la bandeja de un tal `--help`
# (y quedó apuntado en `lecturas` de producción, entre los 101 nombres
# fuera del censo que ① cuenta).
case "${1:-}" in -h|--help) uso; exit 0 ;; esac
case "$cmd" in
  init)   for a in "$@"; do [ "$a" = "--demo" ] && export LLMINBOX_DEMO=1; done
          hacer_init ;;
  inbox) _veta_flags "--carril" "$@" || exit 1; set -- ${_ARGS[@]+"${_ARGS[@]}"};  YO_DERIVADO=""; CARRIL_DERIVADO=""
          _aviso_identidad "${1:-}"
          # sin argumento, eres TÚ: el nombre sale de la sesión, no del teclado
          [ $# -ge 1 ] || { [ -n "$YO_DERIVADO" ] && set -- "$YO_DERIVADO" || { mal_uso; }; }
          carril="${BIK_CARRIL:-$CARRIL_DERIVADO}"; args=()
          while [ $# -gt 0 ]; do
            case "$1" in
              # `$2` sin comprobar revienta bajo `set -u` con "unbound variable"
              # cuando --carril llega como último token — un error crudo de bash
              # donde tocaba un mensaje de uso (rc=2, como el resto de mal-uso).
              --carril) [ $# -ge 2 ] || { echo "· --carril necesita un valor (p.ej. --carril 64bis)" >&2; mal_uso; }
                        carril="$2"; shift 2 ;;
              *) args+=("$1"); shift ;;
