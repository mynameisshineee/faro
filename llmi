                # ve la ruta INTERNA, igual para cualquier fichero, así que sustituir el
                # mapa por otro «no vacío» pasaba sin que nadie midiera la cobertura.
                # EL DIGEST YA CALCULADO, NO UNA RELECTURA. Volver a abrir el
                # snapshot aquí era otra ventana: mutándolo sólo para ESTA lectura, la
                # huella coincidía con la previa y el gate de cobertura se saltaba; se
                # devolvía el original antes de compose y el proceso atestiguaba lo de
                # siempre. Resultado: una REDUCCIÓN de cobertura aplicada sin que nadie
                # la autorizara. Es la cuarta ventana del mismo tipo en este fichero,
                # así que la regla queda escrita: NINGUNA relectura gobierna una
                # decisión — el buffer se lee una vez y todo se deriva de él.
                _nueva="${_SNAP_SHA:-}"
                _previa="$(cat "$(_fichero_huella)" 2>/dev/null || true)"
                if [ "$_nueva" != "$_previa" ] && [ "${_cobertura_ok:-0}" != "1" ]; then
                  echo "⛔ V8 está ENCENDIDO y traes un mapa que NO es el que se aplicó." >&2
                  echo "   Desde el contenedor sólo se ve la ruta interna del montaje, la misma" >&2
                  echo "   para cualquier fichero: no puedo saber si este mapa MANTIENE o REDUCE" >&2
                  echo "   la cobertura de roles. Un mapa \"no vacío\" no es prueba de nada." >&2
                  echo >&2
                  echo "   mide la cobertura:   llmi credenciales $LLMINBOX_CREDENCIALES" >&2
                  echo "                        curl -s \$API/health   (mira v8.roles_cubiertos)" >&2
                  echo "   y si la has medido:  llmi up --cobertura-verificada" >&2
                  exit 1
                fi ;;
            esac
          fi
          [ -r "$TOKFILE" ] || { python3 -c "import secrets;print(secrets.token_urlsafe(32))" > "$TOKFILE"
            chmod 600 "$TOKFILE"; echo "· token generado en $TOKFILE (0600)"; TOKEN="$(tr -d "\n" < "$TOKFILE")"; }
          # Sin esto, un `llmi up` sin `init` previo deja que Docker sustituya
          # el mount de `./roster.json` por un directorio vacío en silencio (ver
          # docker-compose.yml) — el arranque "funciona" y el censo sale vacío.
          [ -r "$ROSTER" ] || { cp "$DIR/roster.example.json" "$ROSTER"
            echo "· roster.json no existía — copiado de roster.example.json (corre 'llmi init' para uno generado de tus ledgers)"; }
          # Mismo agujero que el de ROSTER arriba, para el mapa de carril (③): si
          # `.llmi-mounts.json` no existe ANTES de `docker compose up`, Docker lo
          # sustituye por un directorio vacío en silencio.
          [ -r "$DIR/.llmi-mounts.json" ] || echo '{}' > "$DIR/.llmi-mounts.json"
