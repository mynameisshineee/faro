    else:
        f["estado"] = "presente"; f["_decl"] = decl

# FAIL-CLOSED: con una fuente ilegible NO se puede decir cual es la politica vigente,
# porque la ilegible podria ser la MAS ESTRICTA. Callarse el error y dar el maximo de las
# legibles seria dar un numero mas blando que el real, que es la direccion peligrosa.
if errores:
    print("· ⛔ NO puedo decirte la politica vigente: hay %d fuente(s) ilegible(s)." % len(errores), file=sys.stderr)
    for ruta, err in errores:
        print("     %s\n       %s" % (ruta, err), file=sys.stderr)
    print("     Una fuente ilegible puede ser la MAS ESTRICTA, asi que darte el maximo de", file=sys.stderr)
    print("     las legibles seria darte un modo mas BLANDO que el real. Arreglalas primero.", file=sys.stderr)
    print("     forma: {\"version\":1,\"lanes\":{\"<carril>\":{\"<verbo>\":\"native\"}}}", file=sys.stderr)
    raise SystemExit(1)

def resolver(ln, vb):
    """(efectivo, declarado, origen_ganador, por_fuente)"""
    por_fuente, ganador, mejor = [], None, -1
    for f in fuentes:
        m = f.get("_decl", {}).get((ln, vb), NO_DECL)
        por_fuente.append({"ruta": f["ruta"], "origen": f["origen"],
                           "estado": f["estado"], "declara": m})
        if m is not None and DUREZA[m] > mejor:
            mejor, ganador = DUREZA[m], f
    if ganador is None:
        return "bridge", False, None, por_fuente
    return MODOS[mejor], True, ganador, por_fuente

pares = sorted({k for f in fuentes for k in f.get("_decl", {})})
if carril:
    pares = [k for k in pares if k[0] == carril]
if carril and verbo:
    pares = [(carril, verbo)]

salida = {"fuentes": [{k: v for k, v in f.items() if not k.startswith("_")} for f in fuentes],
          "regla": "gana el mas estricto; lo no declarado NO es una decision, es el suelo",
          "consultas": []}
for ln, vb in pares:
    ef, decl, gan, por_fuente = resolver(ln, vb)
    salida["consultas"].append({
        "carril": ln, "verbo": vb, "efectivo": ef, "declarado": decl,
        "por": "declaracion" if decl else "defecto",
        "origen": (gan["ruta"] if gan else None),
        "origen_tipo": (gan["origen"] if gan else None),
        "por_fuente": por_fuente})

if formato == "json":
    print(json.dumps(salida, ensure_ascii=False, indent=2, sort_keys=False))
    raise SystemExit(0)

print("── fuentes de politica, en el orden en que se leen ──")
if not fuentes:
    print("  (ninguna) — sin fichero de politica, TODO es `bridge` por defecto,")
    print("              y eso es el suelo, no una decision de nadie.")
