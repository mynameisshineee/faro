          # y entre las dos cabe otro `up`: los dos leen «V8 encendido», los dos siguen,
          # y el último que llega a compose lo deja apagado — con rc=0 los dos. El
          # precheck y la mutación son UNA sola sección crítica.
          _tomar_cerrojo          # ANTES de medir y del primer efecto lateral
          # ── EL MAPA SE CONGELA ANTES DE MONTARLO ────────────────────────────
          # La huella de un fichero MUTABLE sólo describe el instante en que se calculó:
          # entre validarlo y que Compose lo consuma cabe una sustitución, y entonces se
          # valida A, se monta B y se sella SHA(B) sin que nada lo note. Se copia bajo el
          # cerrojo a un snapshot por instancia, y es ESE el que se monta — Y CONTRA EL
          # QUE SE VALIDA TODO LO DE ABAJO. Va LO PRIMERO tras el cerrojo por eso: si se
          # congelara después de los chequeos, la ventana viviría DENTRO de ellos y se
          # habría validado un fichero que ya no es el que se aplica. Medido: con el
          # snapshot al final, el falsador sustituía el mapa durante el propio precheck.
          # El snapshot es un mapa de credenciales: nunca hereda un modo permisivo del
          # origen. Docker Desktop conserva el 0600 del bind y el uid efectivo del
          # servicio puede leerlo; si una plataforma no puede, el arranque falla cerrado.
          if [ "${_sin_v8:-0}" != "1" ] && [ -n "${LLMINBOX_CREDENCIALES:-}" ]; then
            _SNAP="$(_fichero_snapshot)"
            cp "$LLMINBOX_CREDENCIALES" "$_SNAP.tmp.$$" \
              && chmod 600 "$_SNAP.tmp.$$" \
              && mv -f "$_SNAP.tmp.$$" "$_SNAP" \
              || { echo "· no pude congelar el mapa en $_SNAP: no monto uno que puede cambiar" >&2
                   rm -f "$_SNAP.tmp.$$"; exit 1; }
            # LOS DOS DIGESTOS SALEN DE **UNA** LECTURA. El sha del sello y el HMAC
            # del atestado se calculaban en momentos distintos, abriendo el snapshot dos
            # veces: si cambiaba en medio, el HMAC coincidía con lo que el servicio
            # cargó (B) y el sello guardaba el sha de lo anterior (A) — `up` con rc=0
            # declarando aplicado un mapa que no es el que corre. La segunda lectura de
            # algo mutable es una ventana aunque el fichero sea mío.
            _DIG="$(python3 - "$_SNAP" "$TOKEN" "$LLMINBOX_NAME" <<'EOPY' 2>/dev/null
import hashlib, hmac, sys
b = open(sys.argv[1], "rb").read()
# El atestado va ATADO A LA INSTANCIA: sin ella, dos instancias con la misma clave y el
# mismo mapa emiten el MISMO valor, y el despliegue de una se sella con el /health de la
# otra — justo el fallo que el atestado existe para impedir.
msg = sys.argv[3].encode() + b"\0" + b
print(hashlib.sha256(b).hexdigest())
print(hmac.new(sys.argv[2].encode(), msg, hashlib.sha256).hexdigest())
EOPY
)"
            _SNAP_SHA="$(printf %s "$_DIG" | sed -n 1p)"
            _SNAP_HMAC="$(printf %s "$_DIG" | sed -n 2p)"
            [ -n "$_SNAP_SHA" ] && [ -n "$_SNAP_HMAC" ] \
              || { echo "· no pude medir el snapshot del mapa: no arranco a ciegas" >&2; exit 1; }
            export LLMINBOX_CREDENCIALES="$_SNAP"      # Compose monta el SNAPSHOT
            # Y EL DIGEST VIAJA CON ÉL. El servicio lo comprueba en CADA arranque, así
            # que un reinicio de Docker —que no pasa por aquí— tampoco puede cargar un
            # mapa sustituido después del atestado. `llmi` no puede prometer nada sobre
            # reinicios que no origina; el proceso sí puede comprobarse a sí mismo.
            export LLMINBOX_CREDENCIALES_SHA="$_SNAP_SHA"
          fi
          if [ "${_sin_v8:-0}" != "1" ]; then
            _v8="$(_estado_v8)"
            case "$_v8" in
              # EXISTE PERO NUNCA ARRANCÓ: no bloquea. No hay cobertura viva que este
              # `up` pueda reducir, así que el gate no discriminaría nada — y su única
              # salida sería un `--cobertura-verificada` que no se puede haber medido.
              # Se dice en voz alta para que proceder no parezca un descuido.
              noarrancado)
                echo "· hay un contenedor \`$LLMINBOX_NAME\` que NUNCA llegó a arrancar" >&2
                echo "  (\`created\`, sin \`StartedAt\`): lo trato como ausente y sigo." >&2 ;;
              nomedido)
                echo "⛔ NO MEDIDO: no puedo leer el entorno del contenedor \`$LLMINBOX_NAME\`," >&2
                echo "   y Docker no dice que no exista. «No lo sé» NO es «estaba apagado»:" >&2
                echo "   confundirlas es exactamente como se apaga un gate por descuido." >&2
                echo "   mira qué pasa:        docker inspect $LLMINBOX_NAME   ·   llmi stat" >&2
                echo "   o decide a sabiendas: llmi up --sin-v8" >&2
                exit 1 ;;
              on)
                if [ -z "${LLMINBOX_CREDENCIALES:-}" ]; then
                  echo "⛔ este \`up\` arrancaría el servicio con V8 APAGADO." >&2
                  echo "   Ahora mismo está ENCENDIDO y tú no traes \`LLMINBOX_CREDENCIALES\`," >&2
                  echo "   así que el contenedor nuevo saldría sin el gate de identidad y sin" >&2
                  echo "   decírselo a nadie. No es tu culpa: la variable sale del shell." >&2
                  echo >&2
                  echo "   consérvalo:  export LLMINBOX_CREDENCIALES=<tu mapa> && llmi up" >&2
                  echo "   valida antes: llmi credenciales <tu mapa>" >&2
                  echo "   apágalo ya:   llmi up --sin-v8   (queda dicho, no silencioso)" >&2
                  exit 1
                fi
