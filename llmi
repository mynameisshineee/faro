TIPOS = {"PRODUCED", "INGESTED", "FYI", "REQUEST", "ACK", "HELD", "AMEND", "DELTA"}
ETIQUETAS = {"HEARTBEAT", "CARRY-FORWARD", "CLAIM", "CANON", "CERT", "DONE",
             "RESP", "AVISO", "MSG", "ASK", "STATUS", "INFO", "HANDOFF"}
PARO = {"the", "and", "for", "con", "por", "las", "los", "una", "uno", "del",
        "que", "más", "sin", "hoy", "aún", "ver", "via", "vía"}
CABECERA = re.compile(r"^\s*#{2,3}\s")
CORCHETE = re.compile(r"\[([^\]]+)\]")
PARENT = re.compile(r"\([^()]*\)")


def nombres_candidatos(rutas_reales):
    """Heurística de censo: cuenta tokens tipo-nombre en cabeceras de entrada.

    Best-effort a propósito — es una PROPUESTA que el operador revisa, no una
    identidad verificada. Lee como mucho los primeros 300 KB de cada ledger:
    con un fichero de 54 MB no hace falta el fichero entero para ver de qué
    nombres está hecho el censo, y así `init` no se cuelga leyendo el canon
    completo de una flota grande.
    """
    cont = {}
    for ruta in rutas_reales:
        try:
            with open(ruta, encoding="utf-8", errors="replace") as fh:
                fragmento = fh.read(300_000)
        except OSError:
            continue
        for linea in fragmento.splitlines():
            if not CABECERA.match(linea):
                continue
            m = CORCHETE.search(linea)
            cuerpo = m.group(1) if m else linea
            cuerpo = PARENT.sub(" ", cuerpo)
            for tok in re.findall(r"[A-Za-z][A-Za-z0-9_-]{2,40}", cuerpo):
                bajo = tok.lower()
                if bajo.upper() in TIPOS or bajo.upper() in ETIQUETAS or bajo in PARO:
                    continue
                cont[bajo] = cont.get(bajo, 0) + 1
    return [n for n, _ in sorted(cont.items(), key=lambda kv: -kv[1])[:12]]


