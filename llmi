                         printf 'v8-mapa:%s\n' "${_SNAP_SHA:-sin-mapa}"; } \
                      | python3 -c 'import hashlib,sys;print(hashlib.sha256(sys.stdin.buffer.read()).hexdigest())')" \
            || { echo "· no pude calcular el estado deseado: no publico ni sello" >&2
                 rm -rf "$_NEXT"; exit 1; }
          case "$_deseado" in
            ????????????????????????????????????????????????????????????????) ;;
            *) echo "· el estado deseado no parece un sha256: no publico ni sello" >&2
               rm -rf "$_NEXT"; exit 1 ;;
          esac

