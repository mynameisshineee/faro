# Sobre el DIGEST que ya tenemos, nunca reabriendo el snapshot.
msg = sys.argv[3].encode() + b"\0" + sys.argv[1].encode()
print(hmac.new(sys.argv[2].encode(), msg, hashlib.sha256).hexdigest())
EOPY
